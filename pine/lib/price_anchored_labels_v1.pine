//@version=5
// =====================================================================
// Library: PriceAnchoredLabels_v1
// ---------------------------------------------------------------------
// 再現ルール（踏み上げ投げ切りで検証済）:
//   1. マーカー(▲) → 同じ足の location.belowbar のみ
//   2. ラベル Y → その足の anchorPrice を yloc.price で固定
//   3. ラベル X → anchorBar + offsetBars（横だけ逃がす）
//   4. × anchorBar + offset で yloc.belowbar（別足の下に吸着する）
//   5. 判定価格はチャートTFと同じなら security 不要
// ---------------------------------------------------------------------
// TV: 一度「ライブラリ」として保存・公開 → インジで import
//   import YOUR_USERNAME/PriceAnchoredLabels_v1/1 as pal
// =====================================================================
library("PriceAnchoredLabels_v1")

// ----- 表示用ユーティリティ -----
export fmtPrice(float v) =>
    na(v) ? "N/A" : str.tostring(v, format.mintick)

export labelY(float anchorPrice, float atrVal, float padAtrMult) =>
    anchorPrice - atrVal * padAtrMult

export labelX(int anchorBar, int offsetBars) =>
    anchorBar + offsetBars

// ----- 価格固定ラベル + 水平コネクタ -----
export drawAnchoredLabel(
     int anchorBar,
     float anchorPrice,
     float atrVal,
     float padAtrMult,
     int offsetBars,
     string txt,
     color bg,
     color connColor,
     bool showConnector,
     bool leftAlign) =>
    float y = labelY(anchorPrice, atrVal, padAtrMult)
    int x = labelX(anchorBar, offsetBars)
    st = leftAlign ? label.style_label_left : label.style_label_up
    label lb = label.new(x, y, txt, xloc=xloc.bar_index, yloc=yloc.price, style=st,
         color=bg, textcolor=color.black, size=size.small)
    line ln = na
    if showConnector
        ln := line.new(anchorBar, anchorPrice, x, anchorPrice, xloc=xloc.bar_index,
             color=connColor, width=1, style=line.style_dotted)
    [lb, ln]

// ----- 黄Entry / 赤SL / 緑TP（約定足から右へ伸ばす）-----
export newTpslLines(int startBar, float entry, float sl, float tp, int extendBars) =>
    int x2 = startBar + extendBars
    line lE = line.new(startBar, entry, x2, entry, xloc=xloc.bar_index, color=color.yellow, width=2)
    line lS = line.new(startBar, sl, x2, sl, xloc=xloc.bar_index, color=color.red, width=2, style=line.style_dashed)
    line lT = line.new(startBar, tp, x2, tp, xloc=xloc.bar_index, color=color.lime, width=2, style=line.style_dashed)
    [lE, lS, lT]

export extendTpslLines(line lE, line lS, line lT, int endBar) =>
    if not na(lE)
        line.set_x2(lE, endBar)
    if not na(lS)
        line.set_x2(lS, endBar)
    if not na(lT)
        line.set_x2(lT, endBar)

export deleteTpslLines(line lE, line lS, line lT) =>
    if not na(lE)
        line.delete(lE)
    if not na(lS)
        line.delete(lS)
    if not na(lT)
        line.delete(lT)
    [na, na, na]

export deleteLabelPair(label lb, line ln) =>
    if not na(lb)
        label.delete(lb)
    if not na(ln)
        line.delete(ln)
    [na, na]

// ----- H4 直計算 vs security（表示ズレ防止）-----
export pickLocal(bool useLocal, float localV, float secV) =>
    useLocal ? localV : secV

export pickLocalBool(bool useLocal, bool localV, bool secV) =>
    useLocal ? localV : secV

// ----- テーブル1行 -----
export tableRow(table t, int row, string k, string v, color vc) =>
    table.cell(t, 0, row, k, text_color=color.white, text_size=size.tiny)
    table.cell(t, 1, row, v, text_color=vc, text_size=size.tiny)
