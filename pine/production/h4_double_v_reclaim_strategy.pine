//@version=5
strategy("H4 Double V Reclaim [Research]", overlay=true, initial_capital=10000, default_qty_type=strategy.fixed, default_qty_value=1, pyramiding=0, calc_on_order_fills=true, calc_on_every_tick=false, process_orders_on_close=false, commission_type=strategy.commission.percent, commission_value=0.0, slippage=2, max_bars_back=5000, max_lines_count=500, max_labels_count=500)

// =====================================================================
// H4 Double V Reclaim [Research]
// ---------------------------------------------------------------------
// Idea:
//   V1: sharp selloff is rejected and price recovers enough.
//   V2: after V1, price makes another smaller V / higher-low V.
//   Entry: buy only when V2 right shoulder breaks the V1 right-shoulder
//          high with strength.
//
// Why separate from T5:
//   T5 checks BB/MACD/stagnation/rebreak after a V candidate.
//   This script searches the visual pattern itself:
//     V -> second V -> strong reclaim.
//
// Default practical hypothesis:
//   - H4 long only.
//   - V1 confirmed pivot high -> pivot low drop >= 3.0 ATR.
//   - V2 starts after V1 low and its start high has recovered >= 61.8% of V1.
//   - V2 start high is treated as the V1 right-shoulder high.
//   - V1 right shoulder must reclaim the V1 left-shoulder origin by default.
//   - V1 right shoulder must not be too extended above the V1 origin.
//   - V2 low holds above V1 38.2% recovery line.
//   - V2 pullback must be large enough versus V1 to avoid tiny noise V.
//   - V2 right shoulder speed >= V2 left shoulder speed x 1.20.
//   - V2 close breaks V1 right-shoulder high + 0.05 ATR.
//   - Body >= 45%, close location >= 60%.
//   - SL = V2 low - 0.25 ATR by default.
//   - TP = 1.5R.
//
// Notes:
//   Run on H4 first. Visual lines use bar_time anchors to reduce chart drift.
// =====================================================================

grpMode = "基本"
requireH4 = input.bool(true, "H4チャートのみ売買", group=grpMode)
skipHoliday = input.bool(true, "12/15〜1/10は新規停止", group=grpMode)
excludeXau = input.bool(true, "XAUUSD/XAUは除外", group=grpMode)
useDateFilter = input.bool(true, "2015〜2026のみ検証", group=grpMode)

grpPivot = "Pivot"
pivotWidth = input.int(3, "Pivot幅", minval=1, maxval=20, group=grpPivot)
atrLen = input.int(14, "ATR期間", minval=1, group=grpPivot)
minSwingAtr = input.float(2.0, "Pivot間の最小スイング(ATR)", minval=0.1, step=0.1, group=grpPivot)
scanPairs = input.int(18, "走査する直近Vペア数", minval=2, maxval=40, group=grpPivot)

grpV1 = "V1 文脈"
v1MinDropAtr = input.float(3.0, "V1 下落幅の最小ATR", minval=0.1, step=0.1, group=grpV1)
v1MinDropSpeed = input.float(0.20, "V1 左肩速度下限(ATR/本)", minval=0.0, step=0.05, group=grpV1)
v1MinDropBars = input.int(2, "V1 左肩の最小本数", minval=1, group=grpV1)
v1MaxDropBars = input.int(36, "V1 左肩の最大本数", minval=2, group=grpV1)
v1RecoverAtV2Start = input.float(0.618, "V2開始時に必要なV1回復率", minval=0.1, maxval=1.5, step=0.001, group=grpV1)
v1RecoverAtV2Max = input.float(1.60, "V2開始時のV1回復率上限", minval=0.5, maxval=5.0, step=0.05, group=grpV1, tooltip="大きく伸びた後の小さい押しをDouble Vとして拾わないための上限です。")
v2LowHoldV1Fib = input.float(0.382, "V2安値が守るV1回復ライン", minval=0.0, maxval=1.0, step=0.001, group=grpV1)
maxBarsV1LowToV2Start = input.int(96, "V1安値→V2開始の最大本数", minval=1, maxval=500, group=grpV1)
requireImmediateDoubleV = input.bool(true, "V1→V2を連続pivotに限定", group=grpV1, tooltip="ONなら H-L-H-L の連続したDouble Vだけを採用します。")
requireV1FullReclaim = input.bool(true, "V1右肩が左肩起点を上抜け", group=grpV1, tooltip="ONなら、V1右肩(V2開始高値)がV1左肩起点を超えない部分戻しは除外します。")
v1ReclaimBufferAtr = input.float(0.05, "V1右肩上抜け余白(ATR)", minval=0.0, step=0.01, group=grpV1)
v1RightSpeedRatioMin = input.float(1.00, "V1右肩速度/左肩速度の下限", minval=0.0, step=0.05, group=grpV1)

grpV2 = "V2 エントリー"
v2MinDropAtr = input.float(1.4, "V2 下落幅の最小ATR", minval=0.1, step=0.1, group=grpV2)
v2MinDropVsV1 = input.float(0.25, "V2下落幅/V1下落幅の下限", minval=0.0, maxval=1.0, step=0.05, group=grpV2, tooltip="小さすぎるV2ノイズを除外します。0.25ならV2の押しがV1下落幅の25%以上必要です。")
v2MinDropSpeed = input.float(0.15, "V2 左肩速度下限(ATR/本)", minval=0.0, step=0.05, group=grpV2)
v2MinSpeedRatio = input.float(1.20, "V2 右肩速度/左肩速度の下限", minval=0.1, step=0.05, group=grpV2)
v2MinDropBars = input.int(3, "V2 左肩の最小本数", minval=1, group=grpV2)
v2MaxDropBars = input.int(24, "V2 左肩の最大本数", minval=2, group=grpV2)
v2MaxRecoveryBars = input.int(30, "V2 右肩の最大本数", minval=1, maxval=300, group=grpV2)
v2CrossBufferAtr = input.float(0.05, "V1右肩高値上抜け余白(ATR)", minval=0.0, step=0.01, group=grpV2)
v2LowBreakInvalidAtr = input.float(0.10, "V2安値割れ失効(ATR)", minval=0.0, step=0.05, group=grpV2)

grpContext = "高値安値コンテキスト"
levelFilterMode = input.string("高値または安値付近", "高値安値フィルタ", options=["なし", "高値または安値付近", "安値付近のみ", "高値付近のみ"], group=grpContext)
levelLookbackBars = input.int(180, "参照する過去本数", minval=20, maxval=1000, group=grpContext)
levelExcludeRecent = input.int(6, "直近除外本数", minval=1, maxval=100, group=grpContext, tooltip="現在のV自身で高値安値ラインが更新されないように、直近本数を除外します。")
nearLowAtr = input.float(2.0, "安値付近の許容幅(ATR)", minval=0.1, step=0.1, group=grpContext)
nearHighAtr = input.float(2.0, "高値付近の許容幅(ATR)", minval=0.1, step=0.1, group=grpContext)
showContextLevels = input.bool(true, "高値安値ライン", group=grpContext)

grpQuality = "シグナル足品質"
minBodyRatio = input.float(0.45, "実体比率下限", minval=0.0, maxval=1.0, step=0.05, group=grpQuality)
minCloseLocation = input.float(0.60, "終値位置下限", minval=0.0, maxval=1.0, step=0.05, group=grpQuality)

grpRisk = "売買"
rr = input.float(1.5, "TP RR", minval=0.1, step=0.1, group=grpRisk)
stopBufferAtr = input.float(0.25, "SL余白(ATR)", minval=0.0, step=0.05, group=grpRisk)
stopMode = input.string("V2安値", "SL基準", options=["V2安値", "V1/V2安値の低い方"], group=grpRisk)
maxHoldBars = input.int(180, "最大保有本数", minval=1, group=grpRisk)

grpView = "表示"
showSignals = input.bool(true, "シグナル表示", group=grpView)
showRejected = input.bool(false, "見送り候補を表示", group=grpView)
showVLines = input.bool(true, "V1/V2ライン", group=grpView)
showLevels = input.bool(true, "SL/TP/起点ライン", group=grpView)
showTable = input.bool(false, "状態テーブル", group=grpView)
maxObjects = input.int(80, "残すラベル/ライン数", minval=10, maxval=300, group=grpView)
labelShiftBars = input.int(0, "ラベル右ずらし", minval=0, maxval=80, group=grpView)
labelOffsetAtr = input.float(3.0, "ラベル上下余白(ATR)", minval=0.5, step=0.5, group=grpView)

fmt(float v) =>
    string out = na(v) ? "N/A" : str.tostring(v, format.mintick)
    out

fmtNum(float v) =>
    string out = na(v) ? "N/A" : str.tostring(v, "#.##")
    out

var label[] labels = array.new_label()
var line[] lines = array.new_line()

keepLabel(label lb) =>
    array.push(labels, lb)
    while array.size(labels) > maxObjects
        label.delete(array.shift(labels))

keepLine(line ln) =>
    array.push(lines, ln)
    while array.size(lines) > maxObjects * 6
        line.delete(array.shift(lines))

float atrValue = ta.atr(atrLen)
float barRange = high - low
float bodyRatio = barRange > 0 ? math.abs(close - open) / barRange : 0.0
float closeLocation = barRange > 0 ? (close - low) / barRange : 0.0
int chartSec = timeframe.in_seconds(timeframe.period)
int barMs = chartSec * 1000

bool h4Ok = not requireH4 or chartSec == 240 * 60
bool holidayOk = not skipHoliday or not ((month == 12 and dayofmonth >= 15) or (month == 1 and dayofmonth <= 10))
bool dateOk = not useDateFilter or (year >= 2015 and year <= 2026)
bool xauSymbol = str.contains(syminfo.ticker, "XAU")
bool symbolOk = not excludeXau or not xauSymbol
float contextHigh = ta.highest(high[levelExcludeRecent], levelLookbackBars)
float contextLow = ta.lowest(low[levelExcludeRecent], levelLookbackBars)

// ---------------------------------------------------------------------
// Confirmed alternating pivots.
// ---------------------------------------------------------------------
float ph = ta.pivothigh(high, pivotWidth, pivotWidth)
float pl = ta.pivotlow(low, pivotWidth, pivotWidth)

var int[] pKinds = array.new_int()
var float[] pPrices = array.new_float()
var int[] pBars = array.new_int()
var int[] pTimes = array.new_int()
var float[] pAtrs = array.new_float()
var string[] usedKeys = array.new_string()

bool acceptedPivot = false
int newKind = 0
float newPrice = na
int newBar = na
int newTime = na
float newAtr = na

if not na(ph) and na(pl)
    newKind := 1
    newPrice := ph
    newBar := bar_index - pivotWidth
    newTime := time[pivotWidth]
    newAtr := atrValue[pivotWidth]
else if not na(pl) and na(ph)
    newKind := -1
    newPrice := pl
    newBar := bar_index - pivotWidth
    newTime := time[pivotWidth]
    newAtr := atrValue[pivotWidth]

if newKind != 0 and not na(newAtr) and newAtr > 0
    int n = array.size(pKinds)
    if n == 0
        array.push(pKinds, newKind)
        array.push(pPrices, newPrice)
        array.push(pBars, newBar)
        array.push(pTimes, newTime)
        array.push(pAtrs, newAtr)
        acceptedPivot := true
    else
        int lastKind = array.get(pKinds, n - 1)
        float lastPrice = array.get(pPrices, n - 1)
        if newKind == lastKind
            bool moreExtreme = (newKind == 1 and newPrice > lastPrice) or (newKind == -1 and newPrice < lastPrice)
            if moreExtreme
                array.set(pPrices, n - 1, newPrice)
                array.set(pBars, n - 1, newBar)
                array.set(pTimes, n - 1, newTime)
                array.set(pAtrs, n - 1, newAtr)
                acceptedPivot := true
        else
            float swing = math.abs(newPrice - lastPrice)
            float lastAtr = array.get(pAtrs, n - 1)
            float threshold = math.max(newAtr, lastAtr) * minSwingAtr
            if swing >= threshold
                array.push(pKinds, newKind)
                array.push(pPrices, newPrice)
                array.push(pBars, newBar)
                array.push(pTimes, newTime)
                array.push(pAtrs, newAtr)
                acceptedPivot := true

while array.size(pKinds) > 100
    array.shift(pKinds)
    array.shift(pPrices)
    array.shift(pBars)
    array.shift(pTimes)
    array.shift(pAtrs)

while array.size(usedKeys) > 300
    array.shift(usedKeys)

// ---------------------------------------------------------------------
// Scan V1 -> V2 sequence.
// ---------------------------------------------------------------------
bool rawSignal = false
bool rejectedCandidate = false
string rejectText = ""

float signalStop = na
float signalTarget = na
float signalV1Start = na
float signalV1Low = na
float signalV2Start = na
float signalV2Low = na
float signalV1DropAtr = na
float signalV2DropAtr = na
float signalV2DropVsV1 = na
float signalV1RightSpeedRatio = na
float signalV2SpeedRatio = na
float signalV1RecoverAtV2 = na
float signalV2HoldFib = na
float signalBody = na
float signalCloseLocation = na
float signalContextHigh = na
float signalContextLow = na
int signalV1StartTime = na
int signalV1LowTime = na
int signalV2StartTime = na
int signalV2LowTime = na
int signalV1DropBars = na
int signalV1RecoveryBars = na
int signalV2DropBars = na
int signalV2RecoveryBars = na
string signalKey = ""
string signalContext = "N/A"

var bool pendingLong = false
var int pendingSignalBar = na
var int entryBar = na
var int lastExitBar = na
var float activeStop = na
var float activeTarget = na

bool exitedThisBar = strategy.position_size == 0 and strategy.position_size[1] != 0
if exitedThisBar
    lastExitBar := bar_index

bool flatNow = strategy.position_size == 0 and not pendingLong and (na(lastExitBar) or bar_index > lastExitBar)
bool baseOk = h4Ok and holidayOk and dateOk and symbolOk and flatNow

if array.size(pKinds) >= 4 and not na(atrValue) and atrValue > 0
    int nP = array.size(pKinds)
    int maxScan = math.min(scanPairs, nP - 1)
    for v2Scan = 0 to 39
        if v2Scan < maxScan and not rawSignal
            int v2Idx = nP - 2 - v2Scan
            int v2Kind0 = array.get(pKinds, v2Idx)
            int v2Kind1 = array.get(pKinds, v2Idx + 1)
            if v2Kind0 == 1 and v2Kind1 == -1
                float v2Start = array.get(pPrices, v2Idx)
                float v2Low = array.get(pPrices, v2Idx + 1)
                int v2StartBar = array.get(pBars, v2Idx)
                int v2LowBar = array.get(pBars, v2Idx + 1)
                int v2StartTime = array.get(pTimes, v2Idx)
                int v2LowTime = array.get(pTimes, v2Idx + 1)
                float v2Drop = v2Start - v2Low
                int v2DropBars = math.max(v2LowBar - v2StartBar, 1)
                int v2RecoveryBars = math.max(bar_index - v2LowBar, 1)
                float v2Buffer = atrValue * v2CrossBufferAtr
                bool v2Crossed = close[1] <= v2Start + v2Buffer and close > v2Start + v2Buffer
                float v2PostLow = low
                for m = 1 to 300
                    if m < v2RecoveryBars and m <= v2MaxRecoveryBars and not na(low[m])
                        v2PostLow := math.min(v2PostLow, low[m])
                float v2DropAtr = v2Drop / atrValue
                float v2LeftSpeed = v2Drop / v2DropBars / atrValue
                float v2RightSpeed = (close - v2Low) / v2RecoveryBars / atrValue
                float v2SpeedRatio = v2LeftSpeed > 0 ? v2RightSpeed / v2LeftSpeed : na
                bool v2DropOk = v2Drop > 0 and v2DropAtr >= v2MinDropAtr and v2LeftSpeed >= v2MinDropSpeed
                bool v2BarsOk = v2DropBars >= v2MinDropBars and v2DropBars <= v2MaxDropBars and v2RecoveryBars <= v2MaxRecoveryBars
                bool v2LowHeld = v2PostLow >= v2Low - atrValue * v2LowBreakInvalidAtr
                bool v2SpeedOk = not na(v2SpeedRatio) and v2SpeedRatio >= v2MinSpeedRatio
                bool qualityOk = bodyRatio >= minBodyRatio and closeLocation >= minCloseLocation

                if v2Crossed and v2DropOk and v2BarsOk and v2LowHeld
                    rejectedCandidate := true
                    rejectText := not baseOk ? "環境NG" : not v2SpeedOk ? "V2右肩不足" : not qualityOk ? "足品質不足" : "V1未成立"

                for v1Scan = 1 to 39
                    if v1Scan <= v2Idx and not rawSignal
                        int v1Idx = v2Idx - v1Scan
                        int v1Kind0 = array.get(pKinds, v1Idx)
                        int v1Kind1 = array.get(pKinds, v1Idx + 1)
                        if v1Kind0 == 1 and v1Kind1 == -1
                            float v1Start = array.get(pPrices, v1Idx)
                            float v1Low = array.get(pPrices, v1Idx + 1)
                            int v1StartBar = array.get(pBars, v1Idx)
                            int v1LowBar = array.get(pBars, v1Idx + 1)
                            int v1StartTime = array.get(pTimes, v1Idx)
                            int v1LowTime = array.get(pTimes, v1Idx + 1)
                            float v1Drop = v1Start - v1Low
                            int v1DropBars = math.max(v1LowBar - v1StartBar, 1)
                            int v1RecoveryBars = math.max(v2StartBar - v1LowBar, 1)
                            float v1DropAtr = v1Drop / atrValue
                            float v1DropSpeed = v1Drop / v1DropBars / atrValue
                            float v1RightSpeed = (v2Start - v1Low) / v1RecoveryBars / atrValue
                            float v1RightSpeedRatio = v1DropSpeed > 0 ? v1RightSpeed / v1DropSpeed : na
                            float v1RecoverAtV2 = v1Drop > 0 ? (v2Start - v1Low) / v1Drop : na
                            float v2HoldFib = v1Drop > 0 ? (v2Low - v1Low) / v1Drop : na
                            float v2DropVsV1 = v1Drop > 0 ? v2Drop / v1Drop : na
                            bool v1DropOk = v1Drop > 0 and v1DropAtr >= v1MinDropAtr and v1DropSpeed >= v1MinDropSpeed
                            bool v1BarsOk = v1DropBars >= v1MinDropBars and v1DropBars <= v1MaxDropBars
                            bool sequenceOk = v1LowBar < v2StartBar and v2StartBar - v1LowBar <= maxBarsV1LowToV2Start
                            bool immediateDoubleVOk = not requireImmediateDoubleV or v2Idx == v1Idx + 2
                            bool v1RecoveredOk = not na(v1RecoverAtV2) and v1RecoverAtV2 >= v1RecoverAtV2Start
                            bool v1NotExtendedOk = not na(v1RecoverAtV2) and v1RecoverAtV2 <= v1RecoverAtV2Max
                            bool v1FullReclaimOk = not requireV1FullReclaim or v2Start > v1Start + atrValue * v1ReclaimBufferAtr
                            bool v1RightSpeedOk = not na(v1RightSpeedRatio) and v1RightSpeedRatio >= v1RightSpeedRatioMin
                            bool v2SizeVsV1Ok = not na(v2DropVsV1) and v2DropVsV1 >= v2MinDropVsV1
                            bool v2HigherLowOk = not na(v2HoldFib) and v2HoldFib >= v2LowHoldV1Fib
                            bool nearMajorLow = not na(contextLow) and (v1Low <= contextLow + atrValue * nearLowAtr or v2Low <= contextLow + atrValue * nearLowAtr)
                            bool nearMajorHigh = not na(contextHigh) and (close >= contextHigh - atrValue * nearHighAtr or v2Start >= contextHigh - atrValue * nearHighAtr)
                            bool contextOk = levelFilterMode == "なし" or (levelFilterMode == "高値または安値付近" and (nearMajorLow or nearMajorHigh)) or (levelFilterMode == "安値付近のみ" and nearMajorLow) or (levelFilterMode == "高値付近のみ" and nearMajorHigh)
                            string doubleKey = str.tostring(v1StartBar) + "-" + str.tostring(v1LowBar) + "-" + str.tostring(v2StartBar) + "-" + str.tostring(v2LowBar)
                            bool unusedOk = not array.includes(usedKeys, doubleKey)
                            bool setupOk = baseOk and unusedOk and contextOk and immediateDoubleVOk and v2Crossed and v1DropOk and v1BarsOk and sequenceOk and v1RecoveredOk and v1NotExtendedOk and v1FullReclaimOk and v1RightSpeedOk and v2SizeVsV1Ok and v2HigherLowOk and v2DropOk and v2BarsOk and v2LowHeld and v2SpeedOk and qualityOk

                            if v2Crossed and v1DropOk and v1BarsOk and sequenceOk and v1RecoveredOk and v2HigherLowOk and v2DropOk and v2BarsOk and v2LowHeld
                                if not immediateDoubleVOk
                                    rejectedCandidate := true
                                    rejectText := "連続2Vでない"
                                else if not v1NotExtendedOk
                                    rejectedCandidate := true
                                    rejectText := "V1右肩が伸びすぎ"
                                else if not v1FullReclaimOk
                                    rejectedCandidate := true
                                    rejectText := "V1右肩が左肩未満"
                                else if not v1RightSpeedOk
                                    rejectedCandidate := true
                                    rejectText := "V1右肩速度不足"
                                else if not v2SizeVsV1Ok
                                    rejectedCandidate := true
                                    rejectText := "V2が小さすぎる"
                                else if not contextOk
                                    rejectedCandidate := true
                                    rejectText := "高安値から遠い"

                            if setupOk
                                float stopBase = stopMode == "V2安値" ? v2Low : math.min(v1Low, v2Low)
                                float stopPrice = stopBase - atrValue * stopBufferAtr
                                float targetPrice = close + (close - stopPrice) * rr
                                if stopPrice < close and targetPrice > close
                                    rawSignal := true
                                    signalStop := stopPrice
                                    signalTarget := targetPrice
                                    signalV1Start := v1Start
                                    signalV1Low := v1Low
                                    signalV2Start := v2Start
                                    signalV2Low := v2Low
                                    signalV1DropAtr := v1DropAtr
                                    signalV2DropAtr := v2DropAtr
                                    signalV2DropVsV1 := v2DropVsV1
                                    signalV1RightSpeedRatio := v1RightSpeedRatio
                                    signalV2SpeedRatio := v2SpeedRatio
                                    signalV1RecoverAtV2 := v1RecoverAtV2
                                    signalV2HoldFib := v2HoldFib
                                    signalBody := bodyRatio
                                    signalCloseLocation := closeLocation
                                    signalContextHigh := contextHigh
                                    signalContextLow := contextLow
                                    signalV1StartTime := v1StartTime
                                    signalV1LowTime := v1LowTime
                                    signalV2StartTime := v2StartTime
                                    signalV2LowTime := v2LowTime
                                    signalV1DropBars := v1DropBars
                                    signalV1RecoveryBars := v1RecoveryBars
                                    signalV2DropBars := v2DropBars
                                    signalV2RecoveryBars := v2RecoveryBars
                                    signalKey := doubleKey
                                    signalContext := nearMajorLow and nearMajorHigh ? "高値+安値" : nearMajorLow ? "安値付近" : nearMajorHigh ? "高値付近" : "なし"

// ---------------------------------------------------------------------
// Orders. Market entry fills next bar open.
// ---------------------------------------------------------------------
if rawSignal and not pendingLong and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
    strategy.exit("LX", "Long", stop=signalStop, limit=signalTarget)
    pendingLong := true
    pendingSignalBar := bar_index
    activeStop := signalStop
    activeTarget := signalTarget
    array.push(usedKeys, signalKey)

if pendingLong and strategy.position_size > 0
    pendingLong := false
    entryBar := bar_index

if pendingLong and bar_index > pendingSignalBar + 2 and strategy.position_size == 0
    pendingLong := false

if exitedThisBar
    entryBar := na
    activeStop := na
    activeTarget := na

if strategy.position_size > 0 and not na(entryBar) and bar_index - entryBar >= maxHoldBars
    strategy.close("Long", comment="Time")

// ---------------------------------------------------------------------
// Visuals.
// ---------------------------------------------------------------------
plot(showContextLevels and levelFilterMode != "なし" ? contextHigh : na, title="Context High", color=color.new(color.lime, 0), linewidth=2, style=plot.style_linebr)
plot(showContextLevels and levelFilterMode != "なし" ? contextLow : na, title="Context Low", color=color.new(color.orange, 0), linewidth=2, style=plot.style_linebr)
plotshape(showSignals and rawSignal, title="Double V Long", style=shape.triangleup, location=location.belowbar, color=color.new(color.lime, 0), size=size.tiny, text="2V")
plot(showLevels and strategy.position_size > 0 ? activeStop : na, title="Active SL", color=color.new(color.red, 0), linewidth=2, style=plot.style_linebr)
plot(showLevels and strategy.position_size > 0 ? activeTarget : na, title="Active TP", color=color.new(color.lime, 0), linewidth=2, style=plot.style_linebr)

if rawSignal and showSignals
    int labelTime = time + barMs * labelShiftBars
    int lineEndTime = time + barMs * 36
    float labelY = low - atrValue * labelOffsetAtr
    string txt = "Double V LONG\n突破: V1右肩高値\n位置: " + signalContext + "\nV1右肩/左肩: " + fmtNum(signalV1RightSpeedRatio) + "x\nV2右肩/左肩: " + fmtNum(signalV2SpeedRatio) + "x\nV2/V1押し: " + fmtNum(signalV2DropVsV1) + "\nV1回復@V2: " + fmtNum(signalV1RecoverAtV2) + "\nV2高値維持: " + fmtNum(signalV2HoldFib) + "\nV1/V2 Drop: " + fmtNum(signalV1DropAtr) + "/" + fmtNum(signalV2DropAtr) + "ATR\nBars V1/V2: " + str.tostring(signalV1DropBars) + "+" + str.tostring(signalV1RecoveryBars) + "/" + str.tostring(signalV2DropBars) + "+" + str.tostring(signalV2RecoveryBars) + "\nSL: " + fmt(signalStop) + "\nTP: " + fmt(signalTarget)
    label lb = label.new(labelTime, labelY, txt, xloc=xloc.bar_time, style=label.style_label_up, color=color.new(color.lime, 0), textcolor=color.black, size=size.tiny)
    keepLabel(lb)
    if showVLines
        keepLine(line.new(signalV1StartTime, signalV1Start, signalV1LowTime, signalV1Low, xloc=xloc.bar_time, color=color.new(color.red, 60), width=2))
        keepLine(line.new(signalV1LowTime, signalV1Low, signalV2StartTime, signalV2Start, xloc=xloc.bar_time, color=color.new(color.lime, 70), width=2))
        keepLine(line.new(signalV2StartTime, signalV2Start, signalV2LowTime, signalV2Low, xloc=xloc.bar_time, color=color.new(color.red, 0), width=3))
        keepLine(line.new(signalV2LowTime, signalV2Low, time, close, xloc=xloc.bar_time, color=color.new(color.lime, 0), width=3))
    if showLevels
        if not na(signalContextHigh)
            keepLine(line.new(signalV2StartTime, signalContextHigh, lineEndTime, signalContextHigh, xloc=xloc.bar_time, color=color.new(color.lime, 35), width=2))
        if not na(signalContextLow)
            keepLine(line.new(signalV2StartTime, signalContextLow, lineEndTime, signalContextLow, xloc=xloc.bar_time, color=color.new(color.orange, 35), width=2))
        keepLine(line.new(signalV2StartTime, signalV2Start, lineEndTime, signalV2Start, xloc=xloc.bar_time, color=color.new(color.aqua, 0), width=2, style=line.style_dashed))
        keepLine(line.new(time, signalStop, lineEndTime, signalStop, xloc=xloc.bar_time, color=color.new(color.red, 0), width=2, style=line.style_dashed))
        keepLine(line.new(time, signalTarget, lineEndTime, signalTarget, xloc=xloc.bar_time, color=color.new(color.lime, 0), width=2, style=line.style_dashed))

if showRejected and rejectedCandidate and not rawSignal
    int rejectTime = time + barMs * labelShiftBars
    label rb = label.new(rejectTime, high + atrValue * labelOffsetAtr, rejectText, xloc=xloc.bar_time, style=label.style_label_down, color=color.new(color.gray, 20), textcolor=color.white, size=size.tiny)
    keepLabel(rb)

var table t = table.new(position.top_right, 2, 13, bgcolor=color.new(color.black, 80), border_color=color.gray, border_width=1)
if showTable and barstate.islast
    table.cell(t, 0, 0, "Method", text_color=color.white, text_size=size.tiny)
    table.cell(t, 1, 0, "Double V", text_color=color.lime, text_size=size.tiny)
    table.cell(t, 0, 1, "Chart", text_color=color.white, text_size=size.tiny)
    table.cell(t, 1, 1, h4Ok ? "H4 OK" : "H4以外", text_color=h4Ok ? color.lime : color.red, text_size=size.tiny)
    table.cell(t, 0, 2, "Symbol", text_color=color.white, text_size=size.tiny)
    table.cell(t, 1, 2, symbolOk ? syminfo.ticker : "XAU除外", text_color=symbolOk ? color.lime : color.orange, text_size=size.tiny)
    table.cell(t, 0, 3, "Holiday", text_color=color.white, text_size=size.tiny)
    table.cell(t, 1, 3, holidayOk ? "OK" : "停止", text_color=holidayOk ? color.lime : color.orange, text_size=size.tiny)
    table.cell(t, 0, 4, "Pivots", text_color=color.white, text_size=size.tiny)
    table.cell(t, 1, 4, str.tostring(array.size(pKinds)), text_color=color.white, text_size=size.tiny)
    table.cell(t, 0, 5, "Last signal", text_color=color.white, text_size=size.tiny)
    table.cell(t, 1, 5, rawSignal ? "ON" : "OFF", text_color=rawSignal ? color.lime : color.gray, text_size=size.tiny)
    table.cell(t, 0, 6, "V2 speed", text_color=color.white, text_size=size.tiny)
    table.cell(t, 1, 6, fmtNum(signalV2SpeedRatio), text_color=color.white, text_size=size.tiny)
    table.cell(t, 0, 7, "V1/V2 Drop", text_color=color.white, text_size=size.tiny)
    table.cell(t, 1, 7, fmtNum(signalV1DropAtr) + " / " + fmtNum(signalV2DropAtr), text_color=color.white, text_size=size.tiny)
    table.cell(t, 0, 8, "V1 rec / hold", text_color=color.white, text_size=size.tiny)
    table.cell(t, 1, 8, fmtNum(signalV1RecoverAtV2) + " / " + fmtNum(signalV2HoldFib), text_color=color.white, text_size=size.tiny)
    table.cell(t, 0, 9, "Body/Close", text_color=color.white, text_size=size.tiny)
    table.cell(t, 1, 9, fmtNum(bodyRatio) + " / " + fmtNum(closeLocation), text_color=color.white, text_size=size.tiny)
    table.cell(t, 0, 10, "Position", text_color=color.white, text_size=size.tiny)
    table.cell(t, 1, 10, strategy.position_size > 0 ? "LONG" : pendingLong ? "PENDING" : "FLAT", text_color=strategy.position_size > 0 ? color.lime : pendingLong ? color.yellow : color.gray, text_size=size.tiny)
    table.cell(t, 0, 11, "Rule", text_color=color.white, text_size=size.tiny)
    table.cell(t, 1, 11, "Break V1 RS high", text_color=color.aqua, text_size=size.tiny)
    table.cell(t, 0, 12, "HL filter", text_color=color.white, text_size=size.tiny)
    table.cell(t, 1, 12, levelFilterMode, text_color=levelFilterMode == "なし" ? color.gray : color.yellow, text_size=size.tiny)

alertcondition(rawSignal, title="H4 Double V Reclaim", message="H4 Double V reclaim long on {{ticker}} @ {{close}}")
