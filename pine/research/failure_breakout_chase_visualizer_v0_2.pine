//@version=5
indicator("Failure Breakout Chase Visualizer v0.2 [Research]", overlay=true, max_labels_count=500, max_lines_count=500)

// =====================================================================
// Failure Breakout Chase Visualizer v0.2 [Research]
// ---------------------------------------------------------------------
// 研究仮説:
//   失敗チャート(「節目抜け飛び乗り」)の実画像分析から抽出した
//   「負け組が入る位置(赤)」を機械的に検出し、その後に来る
//   「本来の正解エントリー(青)」を1組ずつペアで可視化する。
//   失敗の逆が成功側のエッジになる、という仮説の検証用。
//
// v0.1 -> v0.2 の修正:
//   - マーカーが全バーに出て埋まる問題を解消。
//     「状態表示」から「イベント表示(1回だけ)」に変更。
//   - 青(正解)は、赤(飛び乗り)の後 N バー以内の押し目/戻りに限定し、
//     赤→青が1組ずつ出る教材型の見せ方にした。
//
//   赤 ▽/△ 飛乗   = 飛び乗り危険(入ってはいけない所)。1飛び乗りにつき1個。
//   青 △/▽ 買✓/売✓ = 飛び乗りの後の押し目/戻り = 正解エントリー候補。1組につき1個。
//   黄 線         = 直近スイングの節目(抵抗/支持)。
//
// 時間足別の推奨プリセット(1時間足FX基準):
//   1H : extMult 1.8 / runLen 4 / swingLook 20 / armBars 25
//   4H : extMult 1.6 / runLen 3 / swingLook 24 / armBars 20
//   赤が多すぎ: extMult を上げる / runLen を上げる
//   青が出ない: armBars を増やす / pullEma を増やす / roomMult を下げる
// =====================================================================

// ----------------------------- Inputs --------------------------------
grpCore   = "コア設定"
emaLen    = input.int(20,  "平均参照EMA(伸びきり判定)", minval=2,  group=grpCore)
atrLen    = input.int(14,  "ATR期間",                    minval=2,  group=grpCore)
swingLook = input.int(20,  "スイング参照期間(節目)",     minval=3,  group=grpCore)

grpFail   = "飛び乗り(失敗・赤)検出"
extMult   = input.float(1.8, "伸びきりしきい値 |close-EMA|/ATR >", minval=0.1, step=0.1, group=grpFail)
runLen    = input.int(4,     "連続足しきい値(追いかけ)",          minval=1,   group=grpFail)
nearLvl   = input.float(0.8, "節目到達しきい値 ×ATR以内",          minval=0.0, step=0.1, group=grpFail)
chaseBody = input.float(0.6, "追いかけ足の実体 ×ATR以上",          minval=0.0, step=0.1, group=grpFail)

grpWin    = "正解エントリー(青)検出"
pullEma   = input.float(0.6, "EMA回帰しきい値 ×ATR以内",   minval=0.0, step=0.1, group=grpWin)
roomMult  = input.float(1.5, "次の節目までの余裕 ×ATR以上", minval=0.0, step=0.1, group=grpWin)
armBars   = input.int(25,    "赤の後に正解を待つ最大バー数", minval=1,   group=grpWin)
standalone= input.bool(false,"赤がなくても押し目/戻りを表示", group=grpWin)

grpHtf    = "上位足トレンド"
useHtf    = input.bool(true,  "上位足トレンドフィルタを使う", group=grpHtf)
htfTf     = input.timeframe("240", "上位足", group=grpHtf)
htfEmaLen = input.int(50, "上位足EMA", minval=2, group=grpHtf)

grpDraw   = "表示"
showLevel = input.bool(true, "節目ライン表示", group=grpDraw)
showBg    = input.bool(true, "飛び乗りバーの背景強調", group=grpDraw)

// ----------------------------- Core calc -----------------------------
ema   = ta.ema(close, emaLen)
atr   = ta.atr(atrLen)
ext   = atr > 0 ? (close - ema) / atr : 0.0          // +:平均より上 / -:平均より下

recHigh = ta.highest(high, swingLook)[1]
recLow  = ta.lowest(low,  swingLook)[1]

var int upRun = 0
upRun := close > close[1] ? upRun + 1 : 0
var int dnRun = 0
dnRun := close < close[1] ? dnRun + 1 : 0

body    = math.abs(close - open)
bigBull = close > open and body > chaseBody * atr
bigBear = close < open and body > chaseBody * atr

htfEma = request.security(syminfo.tickerid, htfTf, ta.ema(close, htfEmaLen), lookahead=barmerge.lookahead_off)
htfUp  = not useHtf or close > htfEma
htfDn  = not useHtf or close < htfEma

breakUp = close > recHigh or high >= recHigh - nearLvl * atr
breakDn = close < recLow  or low  <= recLow  + nearLvl * atr

// --------------------- 飛び乗り危険(赤) : イベント化 ------------------
chaseLongRaw  = ext >  extMult and breakUp and (bigBull or upRun >= runLen)
chaseShortRaw = ext < -extMult and breakDn and (bigBear or dnRun >= runLen)
// 連続成立を1個に圧縮(立ち上がりのみ)
chaseLong  = chaseLongRaw  and not chaseLongRaw[1]
chaseShort = chaseShortRaw and not chaseShortRaw[1]

// --------------------- 赤の後の待機ウィンドウ(arm) --------------------
var int armL = 0
armL := chaseLong  ? armBars : (armL > 0 ? armL - 1 : 0)
var int armS = 0
armS := chaseShort ? armBars : (armS > 0 ? armS - 1 : 0)

// --------------------- 正解エントリー(青) : イベント化 ----------------
roomUp    = (recHigh - close) > roomMult * atr
roomDn    = (close - recLow)  > roomMult * atr
nearEmaUp = math.abs(close - ema) < pullEma * atr and close >= ema
nearEmaDn = math.abs(close - ema) < pullEma * atr and close <= ema

pullLong  = htfUp and nearEmaUp and roomUp
pullShort = htfDn and nearEmaDn and roomDn
trigLong  = pullLong  and not pullLong[1]
trigShort = pullShort and not pullShort[1]

goodLong  = trigLong  and (armL > 0 or standalone)
goodShort = trigShort and (armS > 0 or standalone)
// 正解が1個出たらウィンドウを消費(1組につき1個)
if goodLong and armL > 0
    armL := 0
if goodShort and armS > 0
    armS := 0

// ----------------------------- Plot ----------------------------------
plot(ema, "EMA", color=color.new(color.gray, 0), linewidth=1)

plotshape(chaseLong,  title="買い飛び乗り危険", style=shape.triangledown, location=location.abovebar, color=color.new(color.red, 0), size=size.small, text="飛乗")
plotshape(chaseShort, title="売り飛び乗り危険", style=shape.triangleup,   location=location.belowbar, color=color.new(color.red, 0), size=size.small, text="飛乗")

plotshape(goodLong,  title="正解(買い)", style=shape.triangleup,   location=location.belowbar, color=color.new(color.aqua, 0), size=size.normal, text="買✓")
plotshape(goodShort, title="正解(売り)", style=shape.triangledown, location=location.abovebar, color=color.new(color.aqua, 0), size=size.normal, text="売✓")

plot(showLevel ? recHigh : na, "直近スイング高値(抵抗)", color=color.new(color.yellow, 40), style=plot.style_linebr, linewidth=1)
plot(showLevel ? recLow  : na, "直近スイング安値(支持)", color=color.new(color.yellow, 40), style=plot.style_linebr, linewidth=1)

bgcolor(showBg and (chaseLong or chaseShort) ? color.new(color.red, 85) : na, title="飛び乗りバー背景")

// ----------------------------- Alerts --------------------------------
alertcondition(chaseLong,  "買い飛び乗り危険", "高値・抵抗への伸びきった飛び乗り(入ってはいけない)")
alertcondition(chaseShort, "売り飛び乗り危険", "安値・支持への伸びきった飛び乗り(入ってはいけない)")
alertcondition(goodLong,   "正解(買い)",       "飛び乗り後の押し目買い候補(失敗の逆)")
alertcondition(goodShort,  "正解(売り)",       "飛び乗り後の戻り売り候補(失敗の逆)")
