//@version=5
strategy("LH3 Synapse B Symbol Presets Strategy v0.8 [Research]",
     overlay=true,
     max_bars_back=5000,
     max_lines_count=500,
     max_labels_count=500,
     pyramiding=0,
     initial_capital=1000000,
     default_qty_type=strategy.fixed,
     default_qty_value=1,
     process_orders_on_close=true,
     calc_on_order_fills=true,
     calc_on_every_tick=false)

// Research only.
// 目的:
// - LH3赤LINE上抜け後のB水平線上抜けを CHECK として表示する
// - CHECKのうち、A水平線まで0.5R以上の余白があるものだけを ENTRY候補 として強調する
// - D1 EMA20上は STRONG、B抜け足の終値位置60%以上は QUALITY として補助表示する
// - 精度モードで、A余白・終値位置・SL幅・B抜け後の飛び乗りを絞る
// - ゴールドのSL幅に対して、実測の円損益感度から現在ロットの想定損失と推奨ロットを表示する
// - 1回の損失を20万円に固定して、SL幅から推奨ロットを逆算する
// - 通貨別プリセットを使い、TradingViewのストラテジーテスターで勝率/PFを見る
// - Danger Filterの右上テーブルを統合し、普段は目視、必要な時だけストラテジー注文をONにする
//
// 検証メモ:
// - XAUUSD H4 B抜け即 RR2/48: 71件, 勝率63.38%, PF2.58, +28.93R, 最大DD5.55R
// - XAUUSD H4 A余白0.5R RR2/48: 58件, 勝率67.24%, PF2.98, +26.45R, 最大DD2.50R
// - D1 EMA20上はPFが高いが件数が減るため、Strict以外では追い風ラベル扱い
//
// 注意:
// - 売買サインではない。目視照合用。
// - Pivotはconfirmedのみ。未確定足の高値/安値は使わない。
// - TradingViewとPythonはデータ配信元・同一足SL/TP処理が異なるため、まず位置の一致を見る。

plot(close, title="Compile Anchor", color=color.new(color.gray, 100))

grpPreset = "Symbol presets"
presetMode = input.string("Auto", "通貨別プリセット", options=["Auto", "Manual", "XAUUSD H4", "GBPJPY H1", "EURJPY H4", "CHFJPY H4", "USDJPY H1", "AUDJPY H4", "SILVER H4", "ALL H4 Balanced"], group=grpPreset)
usePresetParams = input.bool(true, "プリセット値を使う", group=grpPreset)
showPresetLabel = input.bool(false, "プリセット名を表示", group=grpPreset)

string ticker = syminfo.ticker
bool isXau = str.contains(ticker, "XAU")
bool isSilver = str.contains(ticker, "XAG") or str.contains(ticker, "SILVER") or str.contains(ticker, "Silver") or str.contains(ticker, "silver")
bool isGbpJpy = str.contains(ticker, "GBPJPY")
bool isEurJpy = str.contains(ticker, "EURJPY")
bool isChfJpy = str.contains(ticker, "CHFJPY")
bool isUsdJpy = str.contains(ticker, "USDJPY")
bool isAudJpy = str.contains(ticker, "AUDJPY")

// 2026-06-12: NAS100 を Auto で認識（ALL H4 Balanced = NAS100 含む指数/未分類用）
string autoPreset = isXau ? "XAUUSD H4" : isSilver ? "SILVER H4" : isGbpJpy ? "GBPJPY H1" : isEurJpy ? "EURJPY H4" : isChfJpy ? "CHFJPY H4" : isUsdJpy ? "USDJPY H1" : isAudJpy ? "AUDJPY H4" : "ALL H4 Balanced"
string activePreset = presetMode == "Auto" ? autoPreset : presetMode
bool presetActive = usePresetParams and activePreset != "Manual"

f_tf_for_preset(string p) =>
    p == "GBPJPY H1" or p == "USDJPY H1" ? "H1" : "H4"

f_seconds_for_tf(string tf) =>
    tf == "H1" ? 60 * 60 : 240 * 60

grpCore = "LH3 definition"
pivotLeft = input.int(5, "Pivot left", minval=1, maxval=30, group=grpCore)
pivotRight = input.int(5, "Pivot right", minval=1, maxval=30, group=grpCore)
atrLen = input.int(14, "ATR", minval=1, group=grpCore)
minLowerAtr = input.float(0.20, "各lower highの最低切り下げ幅 ATR", minval=0.0, step=0.05, group=grpCore)
lineTouchAtr = input.float(0.55, "H3ラインタッチ許容 ATR", minval=0.0, step=0.05, group=grpCore)
maxBars12 = input.int(160, "H1-H2 最大本数", minval=5, maxval=1000, group=grpCore)
maxBars23 = input.int(160, "H2-H3 最大本数", minval=5, maxval=1000, group=grpCore)
maxActiveBars = input.int(420, "LH3後の監視本数", minval=20, maxval=2000, group=grpCore)

grpConfirm = "Confirm"
lineBreakBufferAtr = input.float(0.05, "赤LINE上抜けバッファ ATR", minval=0.0, step=0.01, group=grpConfirm)
manualBBreakBufferAtr = input.float(0.03, "B/A上抜けバッファ ATR（Manual）", minval=0.0, step=0.01, group=grpConfirm)
manualMaxBarsAfterLineForB = input.int(48, "LINE上抜け後B確認の最大本数（Manual）", minval=1, maxval=300, group=grpConfirm)
manualCooldownBars = input.int(48, "候補の間隔（Manual）", minval=1, maxval=500, group=grpConfirm)

grpDanger = "Danger filter"
// 2026-06-12: テスト結果でBalancedが全銘柄で最良PFだったため既定をBalancedに変更
// (Precisionだと追加フィルタでドル円PF2.20→1.67等に悪化)
precisionMode = input.string("Balanced", "精度モード", options=["Balanced", "Precision", "Strict"], group=grpDanger)
enterAllMode = input.string("Auto", "NO ENTRYフィルタ制御", options=["Auto", "ON（全件）", "OFF（フィルタ有効）"], group=grpDanger,
     tooltip="Auto: 銘柄ごとに最適設定を自動選択。ON: 全CHECK件でエントリー（フィルタ無視）。OFF: フィルタ通過のみエントリー。\n\n銘柄別Auto設定:\n・ゴールド/銀 → フィルタ有効（NO ENTRY除外）PF2.98\n・NAS100 → フィルタ無視（全件）PF2.21\n・ポンド円 → フィルタ無視（全件）PF1.39\n・その他 → フィルタ有効")
// 銘柄別に最適なフィルタON/OFFを自動判定（あなたのTVテスト結果に基づく）
bool isNas = str.contains(ticker, "NAS100") or str.contains(ticker, "NDX") or str.contains(ticker, "US100") or str.contains(ticker, "USTEC")
// 2026-06-12 テスト結果: ゴールド/銀はフィルタON(ENTRYのみ)、他は全件の方がPF高い
// ゴールド(isXau)と銀(isSilver)を含めない → フィルタ有効(ENTRYのみ)
bool autoAllChecks = isNas or isGbpJpy or isEurJpy or isChfJpy or isUsdJpy or isAudJpy
bool enterAllChecks = enterAllMode == "Auto" ? autoAllChecks : enterAllMode == "ON（全件）"
manualUseARoomForEntry = input.bool(true, "ENTRY候補にA余白を要求（Manual）", group=grpDanger)
manualMinARoomR = input.float(0.50, "Aまでの最低余白 R（Manual）", minval=0.0, step=0.10, group=grpDanger)
manualQualityCloseLoc = input.float(0.60, "QUALITY終値位置（Manual）", minval=0.0, maxval=1.0, step=0.05, group=grpDanger)
d1EmaLen = input.int(20, "D1 EMA", minval=1, group=grpDanger)
manualUseD1StrongForEntry = input.bool(false, "ENTRY候補にD1 EMA上も要求（Manual）", group=grpDanger)
manualUseQualityForEntry = input.bool(false, "ENTRY候補にQUALITYも要求（Manual）", group=grpDanger)
manualUseRiskAtrForEntry = input.bool(false, "ENTRY候補にSL幅上限を要求（Manual）", group=grpDanger)
manualMaxRiskAtr = input.float(3.00, "SL幅上限 ATR（Manual）", minval=0.25, step=0.25, group=grpDanger)
manualUseBreakExtForEntry = input.bool(false, "ENTRY候補にB抜け伸びすぎ除外（Manual）", group=grpDanger)
manualMaxBreakExtAtr = input.float(1.20, "Bからの最大伸び ATR（Manual）", minval=0.10, step=0.10, group=grpDanger)

grpRisk = "Validation levels"
enableStrategyOrders = input.bool(true, "検証注文を出す（勝率/PFを見る時だけON）", group=grpRisk)
showValidationLevels = input.bool(true, "Entry/SL/TP表示", group=grpRisk)
useTimeout = input.bool(false, "タイムアウト有効", group=grpRisk, tooltip="OFF推奨(4銘柄で改善)。AUDJPY/GBPJPYのみON推奨。")
manualRr = input.float(2.0, "TP RR（Manual）", minval=0.25, step=0.25, group=grpRisk)
manualMaxHoldBars = input.int(9999, "最大保有本数（Manual）", minval=1, maxval=9999, group=grpRisk)
manualStopBufferAtr = input.float(0.20, "SL余白 ATR（Manual）", minval=0.0, step=0.05, group=grpRisk)
levelExtendBars = input.int(48, "Entry/SL/TPの表示本数", minval=5, maxval=300, group=grpRisk)

bool precisionOn = precisionMode == "Precision" or precisionMode == "Strict"
bool strictOn = precisionMode == "Strict"
// =====================================================================
// 2026-06-12 全銘柄テスト結果を正確に反映（TradingView H4 実測）
// =====================================================================
// RR: ユーロ円/ゴールド = 3.0（伸ばす型）、他 = 2.0（早く取る型）
float presetRr = activePreset == "EURJPY H4" ? 3.0 : activePreset == "XAUUSD H4" ? 3.0 : activePreset == "GBPJPY H1" ? 2.0 : activePreset == "USDJPY H1" ? 2.0 : activePreset == "CHFJPY H4" ? 1.0 : activePreset == "AUDJPY H4" ? 2.0 : activePreset == "SILVER H4" ? 2.0 : 2.0
// タイムアウト: スイングトレード前提で全銘柄60本（H4で約10日間）に統一
// TIME無しだとユーロ円で1年保有、ゴールドで4ヶ月保有など非現実的なトレードが発生。
// 60本 = 約10日間はスイングの時間感覚に合い、スワップ/資金拘束も現実的。
int presetMaxHoldBars = 60
int presetBWindow = activePreset == "XAUUSD H4" ? 48 : activePreset == "GBPJPY H1" ? 72 : activePreset == "USDJPY H1" ? 48 : activePreset == "EURJPY H4" ? 48 : activePreset == "CHFJPY H4" ? 72 : activePreset == "AUDJPY H4" ? 48 : activePreset == "SILVER H4" ? 48 : 48
int presetCooldown = activePreset == "GBPJPY H1" or activePreset == "USDJPY H1" ? 72 : 48
float basePresetMinARoomR = activePreset == "XAUUSD H4" ? 0.50 : activePreset == "SILVER H4" ? 0.50 : activePreset == "ALL H4 Balanced" ? 0.50 : 0.00
float precisionPresetMinARoomR = activePreset == "GBPJPY H1" or activePreset == "USDJPY H1" ? 0.25 : 0.50
float strictPresetMinARoomR = activePreset == "XAUUSD H4" or activePreset == "SILVER H4" or activePreset == "ALL H4 Balanced" ? 1.00 : 0.50
float presetMinARoomR = strictOn ? strictPresetMinARoomR : precisionOn ? math.max(basePresetMinARoomR, precisionPresetMinARoomR) : basePresetMinARoomR
// 2026-06-12: ゴールドはプリセットONでもフィルタを緩くする（Precisionフィルタで0件になる問題）
// ゴールドのテスト結果 PF1.38 は NO ENTRYフィルタON + 精度フィルタOFF で得た数字。
bool xauRelax = activePreset == "XAUUSD H4"
bool basePresetUseARoom = (activePreset == "XAUUSD H4" or activePreset == "SILVER H4" or activePreset == "ALL H4 Balanced") and not xauRelax
bool presetUseARoom = (basePresetUseARoom or precisionOn) and not xauRelax
float presetQualityCloseLoc = activePreset == "XAUUSD H4" ? 0.60 : activePreset == "GBPJPY H1" ? 0.55 : activePreset == "USDJPY H1" ? 0.55 : 0.60
bool presetUseQuality = precisionOn and not xauRelax
bool presetUseD1Strong = strictOn and not xauRelax
bool presetUseRiskAtr = precisionOn and not xauRelax
float presetMaxRiskAtr = 3.00
bool presetUseBreakExt = precisionOn and not xauRelax
float presetMaxBreakExtAtr = strictOn ? 0.80 : 1.20
float presetStopBufferAtr = activePreset == "XAUUSD H4" ? 0.20 : activePreset == "SILVER H4" ? 0.20 : activePreset == "GBPJPY H1" ? 0.15 : activePreset == "USDJPY H1" ? 0.15 : 0.20
float presetBBreakBufferAtr = activePreset == "GBPJPY H1" or activePreset == "USDJPY H1" ? 0.02 : 0.03

float rr = presetActive ? presetRr : manualRr
int maxHoldBars = presetActive ? presetMaxHoldBars : manualMaxHoldBars
int maxBarsAfterLineForB = presetActive ? presetBWindow : manualMaxBarsAfterLineForB
int cooldownBars = presetActive ? presetCooldown : manualCooldownBars
float bBreakBufferAtr = presetActive ? presetBBreakBufferAtr : manualBBreakBufferAtr
float stopBufferAtr = presetActive ? presetStopBufferAtr : manualStopBufferAtr
bool useARoomForEntry = presetActive ? presetUseARoom : manualUseARoomForEntry
float minARoomR = presetActive ? presetMinARoomR : manualMinARoomR
float qualityCloseLoc = presetActive ? presetQualityCloseLoc : manualQualityCloseLoc
bool useD1StrongForEntry = presetActive ? presetUseD1Strong : manualUseD1StrongForEntry
bool useQualityForEntry = presetActive ? presetUseQuality : manualUseQualityForEntry
bool useRiskAtrForEntry = presetActive ? presetUseRiskAtr : manualUseRiskAtrForEntry
float maxRiskAtr = presetActive ? presetMaxRiskAtr : manualMaxRiskAtr
bool useBreakExtForEntry = presetActive ? presetUseBreakExt : manualUseBreakExtForEntry
float maxBreakExtAtr = presetActive ? presetMaxBreakExtAtr : manualMaxBreakExtAtr
string recommendedTf = f_tf_for_preset(activePreset)
bool timeframeOk = timeframe.in_seconds(timeframe.period) == f_seconds_for_tf(recommendedTf)

grpLot = "Lot risk"
showLotRisk = input.bool(false, "ロット損失ラベルを表示", group=grpLot)
currentLots = input.float(50.0, "現在ロット", minval=0.0, step=0.01, group=grpLot)
lotValueMode = input.string("Auto", "円換算モード", options=["Auto", "Manual"], group=grpLot)
manualJpyPerPriceAtCurrentLots = input.float(5000.0, "価格1.00あたり損益円（Manual）", minval=0.0, step=100.0, group=grpLot)
maxRiskJpy = input.float(200000.0, "1回の固定損失 円", minval=0.0, step=10000.0, group=grpLot)
useLotCapForEntry = input.bool(false, "許容損失超過ならENTRY非表示", group=grpLot)
riskLabelRightBars = input.int(10, "損失ラベル右ずらし本数", minval=0, maxval=80, group=grpLot)
riskLabelBelowAtr = input.float(1.80, "損失ラベル下ずらし ATR", minval=0.20, step=0.10, group=grpLot)
bool isJpyPair = str.contains(ticker, "JPY")
float autoJpyPerPricePerLot = isJpyPair ? 10000.0 : 100.0
float jpyPerPriceAtCurrentLots = lotValueMode == "Auto" ? currentLots * autoJpyPerPricePerLot : manualJpyPerPriceAtCurrentLots

grpView = "Visual"
cleanView = input.bool(true, "見やすい表示モード（最新中心）", group=grpView)
showInOut = input.bool(true, "エントリー/決済を大きく表示（IN/OUT）", group=grpView,
     tooltip="戦略の建玉状態から、実際にエントリーした足にIN、決済した足にOUTを大きく表示する。")
showV1Style = input.bool(true, "V1風トレード表示（Entry/SL/TPの線＋損益R）", group=grpView,
     tooltip="TrendBreakV1風。エントリーからEntry/SL/TPの水平線を引き、決済足に Exit +X.XR を色付きで表示する。")
showEventMarkers = input.bool(true, "WAIT/CHECK小マーカー", group=grpView)
showCurrentTrendLine = input.bool(true, "現在の赤LINEを太く表示", group=grpView)
showCheckMarks = input.bool(false, "CHECKを表示", group=grpView)
showEntryMarks = input.bool(false, "ENTRY候補を大きく表示", group=grpView)
showRejectMarks = input.bool(false, "B抜けたがENTRYでない理由を表示", group=grpView)
showStrongQuality = input.bool(false, "STRONG/QUALITY補助ラベル", group=grpView)
showEntryBackground = input.bool(true, "ENTRY背景を薄く表示", group=grpView)
showActiveGuides = input.bool(true, "現在のB/Aガイド表示", group=grpView)
showTrendLines = input.bool(false, "赤LINE履歴表示（手動ON/OFF）", group=grpView)
showABLines = input.bool(false, "A/B水平線履歴表示", group=grpView)
showSetupLabels = input.bool(false, "LH3/B履歴ラベル", group=grpView)
showLineLabels = input.bool(false, "LINE上抜け履歴ラベル", group=grpView)
showStatusLabel = input.bool(false, "固定ステータスラベル", group=grpView)
showStatusMarker = input.bool(false, "上部ステータスマーカー", group=grpView)
statusLabelAtr = input.float(1.20, "ステータス上ずらし ATR", minval=-5.0, maxval=5.0, step=0.10, group=grpView)
showTable = input.bool(true, "Danger統合テーブル", group=grpView)
tablePosInput = input.string("top_right", "テーブル位置", options=["top_left", "top_right", "bottom_left", "bottom_right"], group=grpView)
keepObjects = input.int(180, "残すラベル/ライン数", minval=30, maxval=450, group=grpView)

f_table_pos(string pos) =>
    pos == "top_left" ? position.top_left : pos == "bottom_right" ? position.bottom_right : pos == "bottom_left" ? position.bottom_left : position.top_right

f_num(float x) =>
    na(x) ? "-" : str.tostring(x, "#.###")

f_jpy(float x) =>
    na(x) ? "-" : str.tostring(x, "#.##") + "円"

f_yes(bool x) =>
    x ? "yes" : "no"

var label[] keptLabels = array.new_label()
var line[] keptLines = array.new_line()
var label presetInfoLabel = na
var label statusInfoLabel = na

keep_label(label lb) =>
    array.push(keptLabels, lb)
    while array.size(keptLabels) > keepObjects
        label.delete(array.shift(keptLabels))

keep_line(line ln) =>
    array.push(keptLines, ln)
    while array.size(keptLines) > keepObjects
        line.delete(array.shift(keptLines))

atr = ta.atr(atrLen)
ph = ta.pivothigh(high, pivotLeft, pivotRight)
pl = ta.pivotlow(low, pivotLeft, pivotRight)

d1ClosePrev = request.security(syminfo.tickerid, "D", close[1], lookahead=barmerge.lookahead_off)
d1EmaPrev = request.security(syminfo.tickerid, "D", ta.ema(close, d1EmaLen)[1], lookahead=barmerge.lookahead_off)
d1Strong = not na(d1ClosePrev) and not na(d1EmaPrev) and d1ClosePrev > d1EmaPrev

barRange = high - low
closeLocation = barRange > 0 ? (close - low) / barRange : na
qualityOk = not na(closeLocation) and closeLocation >= qualityCloseLoc

var float h1 = na
var float h2 = na
var float h3 = na
var int h1Bar = na
var int h2Bar = na
var int h3Bar = na

var bool activeSeq = false
var float seqH1 = na
var float seqH2 = na
var float seqH3 = na
var int seqH1Bar = na
var int seqH2Bar = na
var int seqH3Bar = na
var float visibleSlope = na
var bool lineReclaimed = false
var int lineReclaimBar = na
var bool checkDone = false
var bool entryDone = false
var bool aConfirmed = false
var float headLow = na
var int headLowBar = na
var float bLevel = na
var int bBar = na
var bool bFrozen = false
var float structureLow = na
var int lastCheckBar = na

var int setupCount = 0
var int lineCount = 0
var int checkCount = 0
var int entryCount = 0
var int rejectCount = 0
var int strongCount = 0
var int qualityCount = 0
var float lastEntry = na
var float lastStop = na
var float lastTarget = na
var float lastARoomR = na
var float lastRiskWidth = na
var float lastRiskAtr = na
var float lastBreakExtAtr = na
var float lastJpyPerPricePerLot = na
var float lastRiskJpyCurrent = na
var float lastSuggestedLots = na
var bool lastLotOk = true
var int strategyEntryBar = na
var float strategyStop = na
var float strategyTarget = na
var line currentTrendLine = na

if activeSeq and not na(seqH3Bar) and bar_index - seqH3Bar > maxActiveBars
    activeSeq := false
    lineReclaimed := false
    checkDone := false
    entryDone := false
    aConfirmed := false
    lineReclaimBar := na
    headLow := na
    headLowBar := na
    bLevel := na
    bBar := na
    bFrozen := false
    structureLow := na
    if not na(currentTrendLine)
        line.delete(currentTrendLine)
    currentTrendLine := na

if activeSeq and not na(seqH3Bar) and bar_index >= seqH3Bar
    structureLow := na(structureLow) ? low : math.min(structureLow, low)

if activeSeq and not bFrozen and not na(pl)
    int lowBar = bar_index - pivotRight
    float lowPrice = pl
    if lowBar > seqH3Bar and (na(headLow) or lowPrice < headLow)
        headLow := lowPrice
        headLowBar := lowBar
        bLevel := na
        bBar := na

if not na(ph)
    int highBar = bar_index - pivotRight
    float highPrice = ph
    float pAtr = atr[pivotRight]

    if activeSeq and not bFrozen and not na(headLowBar) and highBar > headLowBar and na(bLevel)
        bLevel := highPrice
        bBar := highBar
        if lineReclaimed
            bFrozen := true
        if showABLines and not cleanView
            keep_line(line.new(bBar, bLevel, bBar + maxActiveBars, bLevel, xloc=xloc.bar_index, extend=extend.none, color=color.new(color.aqua, 15), style=line.style_dashed, width=2))
        if showSetupLabels and not cleanView
            keep_label(label.new(bBar, bLevel, "B", xloc=xloc.bar_index, style=label.style_label_down, color=color.new(color.aqua, 0), textcolor=color.black, size=size.tiny))

    h1 := h2
    h1Bar := h2Bar
    h2 := h3
    h2Bar := h3Bar
    h3 := highPrice
    h3Bar := highBar

    bool haveThree = not na(h1) and not na(h2) and not na(h3) and not na(h1Bar) and not na(h2Bar) and not na(h3Bar)
    bool lowerOk = haveThree and h1 > h2 + pAtr * minLowerAtr and h2 > h3 + pAtr * minLowerAtr
    bool spacingOk = haveThree and h2Bar > h1Bar and h3Bar > h2Bar and (h2Bar - h1Bar <= maxBars12) and (h3Bar - h2Bar <= maxBars23)
    float slope12 = haveThree and h2Bar != h1Bar ? (h2 - h1) / (h2Bar - h1Bar) : na
    float expectedH3 = haveThree and not na(slope12) ? h1 + slope12 * (h3Bar - h1Bar) : na
    bool touchOk = haveThree and not na(expectedH3) and math.abs(h3 - expectedH3) <= pAtr * lineTouchAtr
    bool newLowerHighSetup = lowerOk and spacingOk and touchOk

    bool lineLockActive = activeSeq and lineReclaimed and not checkDone and not na(lineReclaimBar) and bar_index - lineReclaimBar <= maxBarsAfterLineForB

    if newLowerHighSetup and not lineLockActive
        activeSeq := true
        setupCount += 1
        seqH1 := h1
        seqH2 := h2
        seqH3 := h3
        seqH1Bar := h1Bar
        seqH2Bar := h2Bar
        seqH3Bar := h3Bar
        visibleSlope := h3Bar != h1Bar ? (h3 - h1) / (h3Bar - h1Bar) : na
        lineReclaimed := false
        checkDone := false
        entryDone := false
        aConfirmed := false
        lineReclaimBar := na
        headLow := na
        headLowBar := na
        bLevel := na
        bBar := na
        bFrozen := false
        structureLow := low
        for k = 0 to pivotRight
            structureLow := math.min(structureLow, low[k])
        if not na(currentTrendLine)
            line.delete(currentTrendLine)
        currentTrendLine := na
        if showCurrentTrendLine
            currentTrendLine := line.new(seqH1Bar, seqH1, seqH3Bar, seqH3, xloc=xloc.bar_index, extend=extend.right, color=color.new(color.red, 0), width=3)
        if showTrendLines
            keep_line(line.new(seqH1Bar, seqH1, seqH3Bar, seqH3, xloc=xloc.bar_index, extend=extend.right, color=color.new(color.red, 35), width=2))
        if showABLines and not cleanView
            keep_line(line.new(seqH3Bar, seqH3, seqH3Bar + maxActiveBars, seqH3, xloc=xloc.bar_index, extend=extend.none, color=color.new(color.orange, 20), style=line.style_dotted, width=1))
        if showSetupLabels and not cleanView
            keep_label(label.new(seqH3Bar, seqH3, "LH3\nA", xloc=xloc.bar_index, style=label.style_label_down, color=color.new(color.orange, 0), textcolor=color.white, size=size.tiny))

lineNow = activeSeq and not na(visibleSlope) and not na(seqH1) and not na(seqH1Bar) ? seqH1 + visibleSlope * (bar_index - seqH1Bar) : na
lineBreakNow = activeSeq and not lineReclaimed and bar_index > seqH3Bar and not na(lineNow) and close > lineNow + atr * lineBreakBufferAtr and barstate.isconfirmed

if lineBreakNow
    lineReclaimed := true
    lineReclaimBar := bar_index
    if not na(bLevel)
        bFrozen := true
    lineCount += 1
    if showLineLabels and not cleanView
        keep_label(label.new(bar_index, high + atr * 0.30, "WAIT\nLINE", xloc=xloc.bar_index, style=label.style_label_up, color=color.new(color.lime, 0), textcolor=color.black, size=size.tiny))

cooldownOk = na(lastCheckBar) or bar_index - lastCheckBar >= cooldownBars
bWithinWindow = not na(lineReclaimBar) and bar_index - lineReclaimBar <= maxBarsAfterLineForB
bEntryThreshold = not na(bLevel) and not na(atr) ? bLevel + atr * bBreakBufferAtr : na
checkNow = activeSeq and lineReclaimed and bWithinWindow and not checkDone and not na(bLevel) and not na(bEntryThreshold) and bar_index > bBar and close > bEntryThreshold and cooldownOk and barstate.isconfirmed
aBreakNow = activeSeq and lineReclaimed and not aConfirmed and not na(seqH3) and close > seqH3 + atr * bBreakBufferAtr and barstate.isconfirmed

hypotheticalStop = activeSeq and not na(structureLow) ? structureLow - atr * stopBufferAtr : na
hypotheticalRisk = not na(hypotheticalStop) ? close - hypotheticalStop : na
currentARoomR = activeSeq and not na(seqH3) and not na(hypotheticalRisk) and hypotheticalRisk > 0 ? (close >= seqH3 ? 999.0 : (seqH3 - close) / hypotheticalRisk) : na
currentRiskAtr = not na(hypotheticalRisk) and not na(atr) and atr > 0 ? hypotheticalRisk / atr : na
currentBreakExtAtr = activeSeq and not na(bLevel) and not na(atr) and atr > 0 ? math.max(close - bLevel, 0.0) / atr : na
currentRiskOk = not na(hypotheticalRisk) and hypotheticalRisk > 0
currentARoomOk = not useARoomForEntry or (not na(currentARoomR) and currentARoomR >= minARoomR)
currentD1Ok = not useD1StrongForEntry or d1Strong
currentQualityOk = not useQualityForEntry or qualityOk
currentRiskAtrOk = not useRiskAtrForEntry or (not na(currentRiskAtr) and currentRiskAtr <= maxRiskAtr)
currentBreakExtOk = not useBreakExtForEntry or (not na(currentBreakExtAtr) and currentBreakExtAtr <= maxBreakExtAtr)
currentFlatOk = strategy.position_size <= 0

if checkNow
    checkDone := true
    lastCheckBar := bar_index
    checkCount += 1

    float entry = close
    float stop = structureLow - atr * stopBufferAtr
    float risk = entry - stop
    float target = risk > 0 ? entry + risk * rr : na
    float aRoomR = risk > 0 and not na(seqH3) ? (entry >= seqH3 ? 999.0 : (seqH3 - entry) / risk) : na
    float riskAtr = risk > 0 and not na(atr) and atr > 0 ? risk / atr : na
    float breakExtAtr = not na(bLevel) and not na(atr) and atr > 0 ? math.max(entry - bLevel, 0.0) / atr : na
    float jpyPerPricePerLot = currentLots > 0 ? jpyPerPriceAtCurrentLots / currentLots : na
    float riskJpyCurrent = risk > 0 ? risk * jpyPerPriceAtCurrentLots : na
    float riskJpyPerLot = risk > 0 and not na(jpyPerPricePerLot) ? risk * jpyPerPricePerLot : na
    float suggestedLots = not na(riskJpyPerLot) and riskJpyPerLot > 0 and maxRiskJpy > 0 ? maxRiskJpy / riskJpyPerLot : na
    bool lotOk = not useLotCapForEntry or (not na(suggestedLots) and currentLots <= suggestedLots)
    bool aRoomOk = not useARoomForEntry or (not na(aRoomR) and aRoomR >= minARoomR)
    bool d1Ok = not useD1StrongForEntry or d1Strong
    bool qOk = not useQualityForEntry or qualityOk
    bool riskAtrOk = not useRiskAtrForEntry or (not na(riskAtr) and riskAtr <= maxRiskAtr)
    bool breakExtOk = not useBreakExtForEntry or (not na(breakExtAtr) and breakExtAtr <= maxBreakExtAtr)
    bool flatOk = strategy.position_size <= 0
    // enterAllChecks: ONなら危険フィルタを無視し、B抜けCHECK全件をエントリーにする（NO ENTRYも入る）。
    // ただし risk>0(SL有効) と flatOk(未保有) は最低条件として常に必須。
    bool entryCandidate = enterAllChecks ? (risk > 0 and flatOk) : (risk > 0 and aRoomOk and d1Ok and qOk and riskAtrOk and breakExtOk and lotOk and flatOk)

    lastEntry := entry
    lastStop := stop
    lastTarget := target
    lastARoomR := aRoomR
    lastRiskWidth := risk
    lastRiskAtr := riskAtr
    lastBreakExtAtr := breakExtAtr
    lastJpyPerPricePerLot := jpyPerPricePerLot
    lastRiskJpyCurrent := riskJpyCurrent
    lastSuggestedLots := suggestedLots
    lastLotOk := not na(suggestedLots) and currentLots <= suggestedLots

    if showCheckMarks and not cleanView
        keep_label(label.new(bar_index, high + atr * 0.55, "CHECK\nB抜け", xloc=xloc.bar_index, style=label.style_label_down, color=color.new(color.aqua, 0), textcolor=color.black, size=size.small))

    if showLotRisk and not cleanView
        string riskText = "RISK " + f_jpy(riskJpyCurrent) + "\n固定 " + f_jpy(maxRiskJpy) + "\n推奨 " + f_num(suggestedLots) + "lot"
        color riskColor = not na(suggestedLots) and currentLots <= suggestedLots ? color.new(color.gray, 5) : color.new(color.red, 0)
        keep_label(label.new(bar_index + riskLabelRightBars, stop - atr * riskLabelBelowAtr, riskText, xloc=xloc.bar_index, style=label.style_label_left, color=riskColor, textcolor=color.white, size=size.tiny))

    if entryCandidate
        entryDone := true
        entryCount += 1
        strategyEntryBar := bar_index
        strategyStop := stop
        strategyTarget := target
        if enableStrategyOrders
            strategy.entry("LH3-B Long", strategy.long, comment=activePreset)
            strategy.exit("LH3-B Exit", "LH3-B Long", stop=strategyStop, limit=strategyTarget)
        if showEntryMarks and not cleanView
            string entryText = "ENTRY候補\nB + A余白\n" + str.tostring(entry, format.mintick)
            keep_label(label.new(bar_index, low - atr * 0.85, entryText, xloc=xloc.bar_index, style=label.style_label_up, color=color.new(color.lime, 0), textcolor=color.black, size=size.normal))
        if showValidationLevels and not cleanView and not na(target)
            keep_line(line.new(bar_index, entry, bar_index + levelExtendBars, entry, xloc=xloc.bar_index, extend=extend.none, color=color.new(color.white, 0), style=line.style_solid, width=3))
            keep_line(line.new(bar_index, stop, bar_index + levelExtendBars, stop, xloc=xloc.bar_index, extend=extend.none, color=color.new(color.red, 0), style=line.style_solid, width=2))
            keep_line(line.new(bar_index, target, bar_index + levelExtendBars, target, xloc=xloc.bar_index, extend=extend.none, color=color.new(color.lime, 0), style=line.style_solid, width=2))
            keep_line(line.new(bar_index, low - atr * 1.25, bar_index, high + atr * 1.25, xloc=xloc.bar_index, extend=extend.none, color=color.new(color.lime, 15), style=line.style_solid, width=2))
            keep_label(label.new(bar_index + levelExtendBars, entry, "ENTRY", xloc=xloc.bar_index, style=label.style_label_left, color=color.new(color.white, 10), textcolor=color.black, size=size.small))
            keep_label(label.new(bar_index + levelExtendBars, stop, "SL", xloc=xloc.bar_index, style=label.style_label_left, color=color.new(color.red, 0), textcolor=color.white, size=size.small))
            keep_label(label.new(bar_index + levelExtendBars, target, "TP " + str.tostring(rr, "#.##") + "R", xloc=xloc.bar_index, style=label.style_label_left, color=color.new(color.lime, 0), textcolor=color.black, size=size.small))
    else
        rejectCount += 1
        string reason = risk <= 0 ? "SL不正" : not aRoomOk ? "A近い" : not d1Ok ? "D1弱い" : not qOk ? "終値弱い" : not riskAtrOk ? "SL幅大" : not breakExtOk ? "飛び乗り" : not lotOk ? "ロット過大" : not flatOk ? "保有中" : "条件不足"
        if showRejectMarks and not cleanView
            keep_label(label.new(bar_index, low - atr * 0.55, "NO ENTRY\n" + reason, xloc=xloc.bar_index, style=label.style_label_up, color=color.new(color.red, 0), textcolor=color.white, size=size.small))

    if showStrongQuality and not cleanView and d1Strong
        strongCount += 1
        keep_label(label.new(bar_index, high + atr * 0.95, "STRONG\nD1 EMA", xloc=xloc.bar_index, style=label.style_label_down, color=color.new(color.green, 0), textcolor=color.white, size=size.tiny))
    if showStrongQuality and not cleanView and qualityOk
        qualityCount += 1
        keep_label(label.new(bar_index, high + atr * 1.25, "QUALITY\nclose", xloc=xloc.bar_index, style=label.style_label_down, color=color.new(color.yellow, 0), textcolor=color.black, size=size.tiny))

if aBreakNow
    aConfirmed := true
    if showSetupLabels and not cleanView
        keep_label(label.new(bar_index, high + atr * 0.80, "A\ncleared", xloc=xloc.bar_index, style=label.style_label_up, color=color.new(color.orange, 0), textcolor=color.black, size=size.tiny))

if enableStrategyOrders and strategy.position_size > 0 and not na(strategyEntryBar)
    strategy.exit("LH3-B Exit", "LH3-B Long", stop=strategyStop, limit=strategyTarget)
    if useTimeout and bar_index - strategyEntryBar >= maxHoldBars
        strategy.close("LH3-B Long", comment="TIME")

if strategy.position_size == 0 and strategy.position_size[1] != 0
    strategyEntryBar := na
    strategyStop := na
    strategyTarget := na

plot(activeSeq ? lineNow : na, title="Active LH3 red pressure line", color=color.new(color.red, 65), linewidth=1)
plot(showActiveGuides and activeSeq and lineReclaimed and not checkDone ? bLevel : na, title="ACTIVE B level", color=color.new(color.aqua, 0), linewidth=4, style=plot.style_linebr)
plot(showActiveGuides and activeSeq and lineReclaimed and not checkDone ? bEntryThreshold : na, title="B close threshold", color=color.new(color.lime, 0), linewidth=2, style=plot.style_linebr)
plot(showActiveGuides and activeSeq and lineReclaimed and not checkDone ? seqH3 : na, title="A level", color=color.new(color.orange, 0), linewidth=2, style=plot.style_linebr)

plotshape(showEventMarkers and lineBreakNow, title="WAIT LINE reclaim", style=shape.triangleup, location=location.belowbar, color=color.orange, size=size.tiny, text="WAIT")
plotshape(showEventMarkers and checkNow, title="CHECK B break", style=shape.triangleup, location=location.belowbar, color=color.aqua, size=size.small, text="CHECK")
plotshape(showEventMarkers and checkNow and currentRiskOk and currentARoomOk and currentD1Ok and currentQualityOk and currentRiskAtrOk and currentBreakExtOk and currentFlatOk, title="ENTRY candidate small", style=shape.circle, location=location.belowbar, color=color.new(color.lime, 0), text="GO", textcolor=color.black, size=size.tiny)
plotshape(showEventMarkers and aBreakNow, title="A confirm", style=shape.triangleup, location=location.belowbar, color=color.orange, size=size.tiny, text="A")
bgcolor(not cleanView and showEntryBackground and checkNow and currentRiskOk and currentARoomOk and currentD1Ok and currentQualityOk and currentRiskAtrOk and currentBreakExtOk and currentFlatOk ? color.new(color.lime, 86) : na, title="ENTRY候補背景")

// === 実際のエントリー / 決済を大きく表示（建玉状態の遷移から検出。常に正確）===
bool justEnteredLong = strategy.position_size > 0 and strategy.position_size[1] <= 0
bool justExited      = strategy.position_size <= 0 and strategy.position_size[1] > 0
plotshape(showInOut and justEnteredLong, title="IN (entry)", style=shape.labelup,
     location=location.belowbar, color=color.new(color.lime, 0), text="IN", textcolor=color.black, size=size.normal)
plotshape(showInOut and justExited, title="OUT (exit)", style=shape.labeldown,
     location=location.abovebar, color=color.new(color.fuchsia, 0), text="OUT", textcolor=color.white, size=size.normal)
// 建玉中は背景を薄く塗って「保有中」を一目で分かるようにする
bgcolor(showInOut and strategy.position_size > 0 ? color.new(color.lime, 92) : na, title="保有中の背景")

// === V1風トレード表示：Entry/SL/TP の線 ＋ 決済足に損益R（緑=勝ち/赤=負け）===
var float tEntry    = na
var float tStop     = na
var float tTarget   = na
var int   tEntryBar = na
var float tRisk     = na

if justEnteredLong
    tEntry    := strategy.position_avg_price
    tStop     := strategyStop
    tTarget   := strategyTarget
    tEntryBar := na(strategyEntryBar) ? bar_index : strategyEntryBar
    tRisk     := not na(tStop) ? tEntry - tStop : na

if showV1Style and justExited and not na(tEntryBar) and not na(tEntry)
    int   ci    = strategy.closedtrades - 1
    float exitP = ci >= 0 ? strategy.closedtrades.exit_price(ci) : close
    float rMult = (not na(tRisk) and tRisk > 0) ? (exitP - tEntry) / tRisk : na
    bool  win   = not na(rMult) and rMult > 0
    color wc    = win ? color.lime : color.red
    keep_line(line.new(tEntryBar, tEntry, bar_index, tEntry, xloc=xloc.bar_index, color=color.new(color.white, 0), width=2))
    if not na(tStop)
        keep_line(line.new(tEntryBar, tStop, bar_index, tStop, xloc=xloc.bar_index, color=color.new(color.red, 30), style=line.style_dashed, width=1))
    if not na(tTarget)
        keep_line(line.new(tEntryBar, tTarget, bar_index, tTarget, xloc=xloc.bar_index, color=color.new(color.lime, 30), style=line.style_dashed, width=1))
    keep_label(label.new(tEntryBar, tEntry, "Long", xloc=xloc.bar_index, style=label.style_label_right, color=color.new(color.gray, 10), textcolor=color.white, size=size.small))
    keep_label(label.new(bar_index, exitP, "Exit " + (rMult >= 0 ? "+" : "") + str.tostring(rMult, "#.#") + "R", xloc=xloc.bar_index, style=label.style_label_left, color=color.new(wc, 0), textcolor=win ? color.black : color.white, size=size.small))

chartIsH4 = timeframe.in_seconds(timeframe.period) == 240 * 60
stateText = not activeSeq ? "NO SETUP" : entryDone ? "ENTRY" : checkDone ? "CHECKED" : lineReclaimed and not na(bLevel) ? "WAIT B BREAK" : lineReclaimed ? "LINE ONLY" : "WAIT LINE"
entryNeedText = entryDone ? f_num(lastEntry) : activeSeq and lineReclaimed and not na(bEntryThreshold) ? "close > " + f_num(bEntryThreshold) : "-"
roomText = na(currentARoomR) ? "-" : currentARoomR >= 900 ? "A cleared" : str.tostring(currentARoomR, "#.##") + "R"
riskAtrText = na(currentRiskAtr) ? "-" : str.tostring(currentRiskAtr, "#.##") + "ATR"
breakExtText = na(currentBreakExtAtr) ? "-" : str.tostring(currentBreakExtAtr, "#.##") + "ATR"
rejectReason = not activeSeq ? "no LH3" : not lineReclaimed ? "wait LINE" : na(bLevel) ? "wait B pivot" : na(bEntryThreshold) ? "wait ATR" : not bWithinWindow ? "B window over" : close <= bEntryThreshold ? "close below B" : not currentRiskOk ? "risk invalid" : not currentARoomOk ? "A room < " + str.tostring(minARoomR, "#.##") + "R" : not currentD1Ok ? "D1 EMA weak" : not currentQualityOk ? "close location weak" : not currentRiskAtrOk ? "SL > " + str.tostring(maxRiskAtr, "#.##") + "ATR" : not currentBreakExtOk ? "B ext > " + str.tostring(maxBreakExtAtr, "#.##") + "ATR" : not currentFlatOk ? "in trade" : "ENTRY候補"

plotshape(showStatusMarker and barstate.islast, title="LH3 STATUS marker", style=shape.labeldown, location=location.top, color=color.new(color.blue, 0), text="LH3\nSTATUS", textcolor=color.white, size=size.small)

if barstate.islast
    label.delete(statusInfoLabel)
    if showStatusLabel
        float statusY = high + nz(atr, 0.0) * statusLabelAtr
        string statusText = "LH3 STATUS v0.8"
        statusText := statusText + "\n" + activePreset + " / TF " + recommendedTf + (timeframeOk ? " OK" : " 確認")
        statusText := statusText + "\nmode: " + precisionMode
        statusText := statusText + "\nstate: " + stateText
        statusText := statusText + "\n次: " + rejectReason
        statusText := statusText + "\nENTRY: " + entryNeedText
        statusText := statusText + "\nA余白: " + roomText
        statusText := statusText + "\nCHECK/ENTRY: " + str.tostring(checkCount) + " / " + str.tostring(entryCount)
        statusText := statusText + "\n推奨lot: " + f_num(lastSuggestedLots)
        color statusColor = rejectReason == "ENTRY候補" ? color.new(color.lime, 0) : stateText == "WAIT B BREAK" ? color.new(color.aqua, 0) : stateText == "LINE ONLY" ? color.new(color.orange, 0) : color.new(color.black, 0)
        statusInfoLabel := label.new(bar_index, statusY, statusText, xloc=xloc.bar_index, style=label.style_label_down, color=statusColor, textcolor=rejectReason == "ENTRY候補" ? color.black : color.white, size=size.normal)

if barstate.islast and showPresetLabel
    label.delete(presetInfoLabel)
    string presetText = activePreset + "\nTF " + recommendedTf + (timeframeOk ? " OK" : " 確認") + "\nRR " + str.tostring(rr, "#.##") + " / hold " + str.tostring(maxHoldBars)
    presetInfoLabel := label.new(bar_index, high + atr * 1.75, presetText, xloc=xloc.bar_index, style=label.style_label_down, color=timeframeOk ? color.new(color.black, 0) : color.new(color.orange, 0), textcolor=color.white, size=size.small)

var table t = table.new(f_table_pos(tablePosInput), 2, 24, bgcolor=color.new(color.black, 8), frame_color=color.new(color.white, 40), frame_width=1, border_color=color.new(color.gray, 40), border_width=1)
if barstate.islast and showTable
    table.cell(t, 0, 0, "LH3 B Combo v0.8", text_color=color.white, text_size=size.small)
    table.cell(t, 1, 0, timeframe.period, text_color=timeframeOk ? color.lime : color.orange, text_size=size.tiny)
    table.cell(t, 0, 1, "preset / TF", text_color=color.silver, text_size=size.tiny)
    table.cell(t, 1, 1, activePreset + " / " + recommendedTf + (timeframeOk ? " OK" : " 確認"), text_color=timeframeOk ? color.lime : color.orange, text_size=size.tiny)
    table.cell(t, 0, 2, "state", text_color=color.silver, text_size=size.tiny)
    table.cell(t, 1, 2, stateText, text_color=entryDone ? color.lime : checkDone ? color.aqua : lineReclaimed ? color.lime : color.silver, text_size=size.tiny)
    table.cell(t, 0, 3, "precision", text_color=color.yellow, text_size=size.tiny)
    table.cell(t, 1, 3, precisionMode, text_color=precisionOn ? color.yellow : color.silver, text_size=size.tiny)
    table.cell(t, 0, 4, "setup / LINE", text_color=color.silver, text_size=size.tiny)
    table.cell(t, 1, 4, str.tostring(setupCount) + " / " + str.tostring(lineCount), text_color=color.white, text_size=size.tiny)
    table.cell(t, 0, 5, "CHECK / ENTRY", text_color=color.silver, text_size=size.tiny)
    table.cell(t, 1, 5, str.tostring(checkCount) + " / " + str.tostring(entryCount), text_color=color.white, text_size=size.tiny)
    table.cell(t, 0, 6, "rejected", text_color=color.red, text_size=size.tiny)
    table.cell(t, 1, 6, str.tostring(rejectCount), text_color=color.red, text_size=size.tiny)
    table.cell(t, 0, 7, "B level", text_color=color.aqua, text_size=size.tiny)
    table.cell(t, 1, 7, f_num(bLevel), text_color=color.aqua, text_size=size.tiny)
    table.cell(t, 0, 8, "A level", text_color=color.orange, text_size=size.tiny)
    table.cell(t, 1, 8, f_num(seqH3), text_color=color.orange, text_size=size.tiny)
    table.cell(t, 0, 9, "A room now", text_color=color.lime, text_size=size.tiny)
    table.cell(t, 1, 9, roomText, text_color=currentARoomOk ? color.lime : color.orange, text_size=size.tiny)
    table.cell(t, 0, 10, "D1 > EMA" + str.tostring(d1EmaLen), text_color=color.green, text_size=size.tiny)
    table.cell(t, 1, 10, f_yes(d1Strong), text_color=d1Strong ? color.lime : color.orange, text_size=size.tiny)
    table.cell(t, 0, 11, "QUALITY", text_color=color.yellow, text_size=size.tiny)
    table.cell(t, 1, 11, f_yes(qualityOk) + " / " + f_num(closeLocation), text_color=qualityOk ? color.lime : color.orange, text_size=size.tiny)
    table.cell(t, 0, 12, "SL ATR", text_color=color.silver, text_size=size.tiny)
    table.cell(t, 1, 12, riskAtrText + " / max " + str.tostring(maxRiskAtr, "#.##"), text_color=currentRiskAtrOk ? color.lime : color.orange, text_size=size.tiny)
    table.cell(t, 0, 13, "B伸び", text_color=color.silver, text_size=size.tiny)
    table.cell(t, 1, 13, breakExtText + " / max " + str.tostring(maxBreakExtAtr, "#.##"), text_color=currentBreakExtOk ? color.lime : color.orange, text_size=size.tiny)
    table.cell(t, 0, 14, "ENTRY条件", text_color=color.lime, text_size=size.tiny)
    table.cell(t, 1, 14, entryNeedText, text_color=color.lime, text_size=size.tiny)
    table.cell(t, 0, 15, "未ENTRY理由", text_color=color.orange, text_size=size.tiny)
    table.cell(t, 1, 15, rejectReason, text_color=rejectReason == "ENTRY候補" ? color.lime : color.orange, text_size=size.tiny)
    table.cell(t, 0, 16, "RR / hold", text_color=color.silver, text_size=size.tiny)
    table.cell(t, 1, 16, str.tostring(rr, "#.##") + " / " + str.tostring(maxHoldBars), text_color=color.white, text_size=size.tiny)
    table.cell(t, 0, 17, "現在lot", text_color=color.silver, text_size=size.tiny)
    table.cell(t, 1, 17, str.tostring(currentLots, "#.##"), text_color=lastLotOk ? color.lime : color.red, text_size=size.tiny)
    table.cell(t, 0, 18, "1.00損益", text_color=color.silver, text_size=size.tiny)
    table.cell(t, 1, 18, f_jpy(jpyPerPriceAtCurrentLots) + " / " + lotValueMode, text_color=color.white, text_size=size.tiny)
    table.cell(t, 0, 19, "固定損失", text_color=color.yellow, text_size=size.tiny)
    table.cell(t, 1, 19, f_jpy(maxRiskJpy), text_color=color.yellow, text_size=size.tiny)
    table.cell(t, 0, 20, "SL幅", text_color=color.silver, text_size=size.tiny)
    table.cell(t, 1, 20, f_num(lastRiskWidth), text_color=color.white, text_size=size.tiny)
    table.cell(t, 0, 21, "今のlot損失", text_color=lastLotOk ? color.silver : color.red, text_size=size.tiny)
    table.cell(t, 1, 21, f_jpy(lastRiskJpyCurrent), text_color=lastLotOk ? color.lime : color.red, text_size=size.tiny)
    table.cell(t, 0, 22, "推奨lot", text_color=color.lime, text_size=size.tiny)
    table.cell(t, 1, 22, f_num(lastSuggestedLots), text_color=color.lime, text_size=size.tiny)
    table.cell(t, 0, 23, "orders", text_color=color.silver, text_size=size.tiny)
    table.cell(t, 1, 23, enableStrategyOrders ? "ON" : "OFF visual", text_color=enableStrategyOrders ? color.yellow : color.lime, text_size=size.tiny)

alertcondition(lineBreakNow, title="LH3 WAIT LINE reclaim", message="LH3 red line reclaimed. Wait for B confirmation on {{ticker}} {{interval}}")
alertcondition(checkNow, title="LH3 CHECK B break", message="LH3 CHECK: LINE+B break on {{ticker}} {{interval}}")
alertcondition(checkNow and currentRiskOk and currentARoomOk and currentD1Ok and currentQualityOk and currentRiskAtrOk and currentBreakExtOk and currentFlatOk, title="LH3 ENTRY candidate", message="LH3 ENTRY candidate: LINE+B precision filter on {{ticker}} {{interval}}")
alertcondition(checkNow and not currentARoomOk, title="LH3 NO ENTRY A too close", message="LH3 B break rejected because A room is too small on {{ticker}} {{interval}}")
