//@version=5
indicator("Lower High 3 Touch Breakdown Event Scanner v0.1 [Research]",
     overlay=true,
     max_bars_back=5000,
     max_lines_count=200,
     max_labels_count=200)

// Research only.
// 目的:
// - 3つの confirmed lower high
// - H1-H2下降ライン延長上にH3が近い
// - H3後の下方向ブレイク
// - 24/48/120本後の short方向 MFE/MAE をATR単位で観察
//
// 注意:
// - 売買サインではない。
// - Pivotはconfirmedのみ。リアルタイムで未確定の高値は使わない。
// - Event scanner段階なので、まずは発火位置と平均MFE/MAEを見る。

plot(close, title="Compile Anchor", color=color.new(color.gray, 100))

grpCore = "Event definition"
pivotLeft = input.int(5, "Pivot left", minval=1, maxval=30, group=grpCore)
pivotRight = input.int(5, "Pivot right", minval=1, maxval=30, group=grpCore)
atrLen = input.int(14, "ATR", minval=1, group=grpCore)
minLowerAtr = input.float(0.20, "各lower highの最低切り下げ幅 ATR", minval=0.0, step=0.05, group=grpCore)
lineTouchAtr = input.float(0.55, "H3ラインタッチ許容 ATR", minval=0.0, step=0.05, group=grpCore)
maxBars12 = input.int(160, "H1-H2 最大本数", minval=5, maxval=1000, group=grpCore)
maxBars23 = input.int(160, "H2-H3 最大本数", minval=5, maxval=1000, group=grpCore)
breakLookback = input.int(24, "下抜けサポート lookback", minval=5, maxval=300, group=grpCore)
breakBufferAtr = input.float(0.05, "下抜けバッファ ATR", minval=0.0, step=0.01, group=grpCore)
cooldownBars = input.int(48, "イベント間隔", minval=1, maxval=500, group=grpCore)

grpFilter = "Context filters"
useEmaFilter = input.bool(false, "EMA下だけ有効", group=grpFilter)
emaLen = input.int(100, "EMA", minval=1, group=grpFilter)
useBodyFilter = input.bool(false, "ブレイク足の実体を要求", group=grpFilter)
minBodyRatio = input.float(0.35, "実体比率", minval=0.0, maxval=1.0, step=0.05, group=grpFilter)

grpView = "Visual"
showTrendLines = input.bool(true, "下降ライン表示", group=grpView)
showEventLabels = input.bool(true, "イベントラベル表示", group=grpView)
showBreakSupport = input.bool(true, "下抜け水準表示", group=grpView)
showTable = input.bool(true, "MFE/MAEテーブル", group=grpView)
tablePosInput = input.string("top_right", "テーブル位置", options=["top_right", "top_left", "bottom_right", "bottom_left"], group=grpView)

f_table_pos(string pos) =>
    pos == "top_left" ? position.top_left : pos == "bottom_right" ? position.bottom_right : pos == "bottom_left" ? position.bottom_left : position.top_right

f_num(float x) =>
    na(x) ? "—" : str.tostring(x, "#.##")

f_avg(float sum, int count) =>
    count > 0 ? sum / count : na

atr = ta.atr(atrLen)
ema = ta.ema(close, emaLen)
body = math.abs(close - open)
barRange = high - low
bodyRatio = barRange > 0 ? body / barRange : 0.0

ph = ta.pivothigh(high, pivotLeft, pivotRight)

var float h1 = na
var float h2 = na
var float h3 = na
var int h1Bar = na
var int h2Bar = na
var int h3Bar = na
var bool activeSeq = false
var bool eventDoneForSeq = false
var int activeSeqBar = na
var line activeLine = na

bool newLowerHighSetup = false

if not na(ph)
    int pBar = bar_index - pivotRight
    float pPrice = ph
    float pAtr = atr[pivotRight]

    h1 := h2
    h1Bar := h2Bar
    h2 := h3
    h2Bar := h3Bar
    h3 := pPrice
    h3Bar := pBar

    bool haveThree = not na(h1) and not na(h2) and not na(h3) and not na(h1Bar) and not na(h2Bar) and not na(h3Bar)
    bool lowerOk = haveThree and h1 > h2 + pAtr * minLowerAtr and h2 > h3 + pAtr * minLowerAtr
    bool spacingOk = haveThree and h2Bar > h1Bar and h3Bar > h2Bar and (h2Bar - h1Bar <= maxBars12) and (h3Bar - h2Bar <= maxBars23)
    float slope12 = haveThree and h2Bar != h1Bar ? (h2 - h1) / (h2Bar - h1Bar) : na
    float expectedH3 = haveThree and not na(slope12) ? h1 + slope12 * (h3Bar - h1Bar) : na
    bool touchOk = haveThree and not na(expectedH3) and math.abs(h3 - expectedH3) <= pAtr * lineTouchAtr
    newLowerHighSetup := lowerOk and spacingOk and touchOk

    if newLowerHighSetup
        activeSeq := true
        eventDoneForSeq := false
        activeSeqBar := h3Bar
        if showTrendLines
            activeLine := line.new(h1Bar, h1, h3Bar, h3, xloc=xloc.bar_index, extend=extend.right, color=color.new(color.red, 0), width=2)
        if showEventLabels
            label.new(h3Bar, h3, "LH3\nline touch", xloc=xloc.bar_index, style=label.style_label_down, color=color.new(color.orange, 0), textcolor=color.white, size=size.tiny)

support = ta.lowest(low[1], breakLookback)
breakLevel = support - atr * breakBufferAtr
emaOk = not useEmaFilter or close < ema
bodyOk = not useBodyFilter or (close < open and bodyRatio >= minBodyRatio)

var int lastEventBar = na
cooldownOk = na(lastEventBar) or bar_index - lastEventBar >= cooldownBars
breakdownEvent = activeSeq and not eventDoneForSeq and bar_index > activeSeqBar and cooldownOk and close < breakLevel and emaOk and bodyOk and barstate.isconfirmed

var array<int> eventBars = array.new_int()
var array<float> eventEntries = array.new_float()
var array<float> eventAtrs = array.new_float()
var array<float> eventLows = array.new_float()
var array<float> eventHighs = array.new_float()

var int eventCount = 0
var float sumMfe24 = 0.0
var float sumMae24 = 0.0
var int cnt24 = 0
var float sumMfe48 = 0.0
var float sumMae48 = 0.0
var int cnt48 = 0
var float sumMfe120 = 0.0
var float sumMae120 = 0.0
var int cnt120 = 0

if breakdownEvent
    eventDoneForSeq := true
    lastEventBar := bar_index
    eventCount += 1
    array.push(eventBars, bar_index)
    array.push(eventEntries, close)
    array.push(eventAtrs, atr)
    array.push(eventLows, low)
    array.push(eventHighs, high)

    if showEventLabels
        label.new(bar_index, low - atr * 0.25, "LH3 BREAK\nMFE study", xloc=xloc.bar_index, style=label.style_label_up, color=color.new(color.red, 0), textcolor=color.white, size=size.small)
    if showBreakSupport
        line.new(bar_index, breakLevel, bar_index + 120, breakLevel, xloc=xloc.bar_index, extend=extend.none, color=color.new(color.red, 35), style=line.style_dashed)

int openEvents = array.size(eventBars)
if openEvents > 0
    for n = 0 to openEvents - 1
        int i = openEvents - 1 - n
        int eBar = array.get(eventBars, i)
        float eEntry = array.get(eventEntries, i)
        float eAtr = array.get(eventAtrs, i)
        float eLow = math.min(array.get(eventLows, i), low)
        float eHigh = math.max(array.get(eventHighs, i), high)
        array.set(eventLows, i, eLow)
        array.set(eventHighs, i, eHigh)

        int age = bar_index - eBar
        float mfe = eAtr > 0 ? (eEntry - eLow) / eAtr : na
        float mae = eAtr > 0 ? (eHigh - eEntry) / eAtr : na

        if age == 24 and not na(mfe) and not na(mae)
            sumMfe24 += mfe
            sumMae24 += mae
            cnt24 += 1
        if age == 48 and not na(mfe) and not na(mae)
            sumMfe48 += mfe
            sumMae48 += mae
            cnt48 += 1
        if age == 120 and not na(mfe) and not na(mae)
            sumMfe120 += mfe
            sumMae120 += mae
            cnt120 += 1

        if age >= 120
            array.remove(eventBars, i)
            array.remove(eventEntries, i)
            array.remove(eventAtrs, i)
            array.remove(eventLows, i)
            array.remove(eventHighs, i)

plotshape(breakdownEvent, title="LH3 Breakdown Event", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small, text="LH3")
plot(useEmaFilter ? ema : na, title="EMA filter", color=color.new(color.blue, 50))

var table t = table.new(f_table_pos(tablePosInput), 4, 5, bgcolor=color.new(color.black, 10), border_width=1)
if barstate.islast and showTable
    table.cell(t, 0, 0, "LH3 Breakdown", text_color=color.white, text_size=size.small)
    table.cell(t, 1, 0, "events", text_color=color.silver, text_size=size.tiny)
    table.cell(t, 2, 0, str.tostring(eventCount), text_color=color.white, text_size=size.small)
    table.cell(t, 3, 0, timeframe.period, text_color=color.silver, text_size=size.tiny)

    table.cell(t, 0, 1, "horizon", text_color=color.white, text_size=size.tiny)
    table.cell(t, 1, 1, "avg MFE", text_color=color.lime, text_size=size.tiny)
    table.cell(t, 2, 1, "avg MAE", text_color=color.orange, text_size=size.tiny)
    table.cell(t, 3, 1, "n", text_color=color.silver, text_size=size.tiny)

    table.cell(t, 0, 2, "24", text_color=color.white, text_size=size.tiny)
    table.cell(t, 1, 2, f_num(f_avg(sumMfe24, cnt24)), text_color=color.lime, text_size=size.tiny)
    table.cell(t, 2, 2, f_num(f_avg(sumMae24, cnt24)), text_color=color.orange, text_size=size.tiny)
    table.cell(t, 3, 2, str.tostring(cnt24), text_color=color.silver, text_size=size.tiny)

    table.cell(t, 0, 3, "48", text_color=color.white, text_size=size.tiny)
    table.cell(t, 1, 3, f_num(f_avg(sumMfe48, cnt48)), text_color=color.lime, text_size=size.tiny)
    table.cell(t, 2, 3, f_num(f_avg(sumMae48, cnt48)), text_color=color.orange, text_size=size.tiny)
    table.cell(t, 3, 3, str.tostring(cnt48), text_color=color.silver, text_size=size.tiny)

    table.cell(t, 0, 4, "120", text_color=color.white, text_size=size.tiny)
    table.cell(t, 1, 4, f_num(f_avg(sumMfe120, cnt120)), text_color=color.lime, text_size=size.tiny)
    table.cell(t, 2, 4, f_num(f_avg(sumMae120, cnt120)), text_color=color.orange, text_size=size.tiny)
    table.cell(t, 3, 4, str.tostring(cnt120), text_color=color.silver, text_size=size.tiny)

alertcondition(breakdownEvent, title="LH3 Breakdown Event", message="Lower High 3 Touch Breakdown event on {{ticker}} {{interval}}")
