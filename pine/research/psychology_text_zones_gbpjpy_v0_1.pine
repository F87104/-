//@version=5
indicator("Psychology Text Zones - GBPJPY v0.1.1 [Research]", overlay=true, max_labels_count=500, max_boxes_count=100, max_lines_count=50)

// =====================================================================
// Psychology Text Zones - GBPJPY v0.1.1 [Research]
// ---------------------------------------------------------------------
// 850件心理テキスト（v0.5実行380件と非重複）の意識価格帯
// ソース行 45 → 表示ゾーン 6（近接マージ後・上位のみ）
// 紫破線=意識節目（約定ではない） / 1H推奨 / v0.5と併用時は件数フィルタを上げる
// =====================================================================

pairOk = syminfo.basecurrency == "GBP" and syminfo.currency == "JPY"
showZones   = input.bool(true,  "意識価格線(紫破線)を表示")
showLabels  = input.bool(false, "右端ラベルを表示")
showTable   = input.bool(true,  "一覧テーブル(右上)を表示")
maxZones    = input.int(6, "最大表示ゾーン数", minval=1, maxval=20)
minCount    = input.int(3,      "最小件数", minval=1, maxval=20)
onlyDanger  = input.bool(false, "負け率50%超のみ")

var table psychTbl = table.new(position.top_right, 3, 8, bgcolor=color.new(color.black, 15), border_width=1)

// Z0: 195 n=14 loss=4 根拠不足
// Z1: 192 n=12 loss=5 根拠不足
// Z2: 189 n=7 loss=2 根拠不足
// Z3: 198 n=5 loss=0 根拠不足
// Z4: 200 n=4 loss=2 根拠不足
// Z5: 184 n=3 loss=1 エントリーが早い

if barstate.islast
    if not pairOk
        label.new(bar_index, high, "⚠ GBPJPY 専用\n心理テキスト v0.1.1", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_lower_left, color=color.new(color.orange, 0), textcolor=color.white, size=size.normal)
    else
        shown = 0
        if showTable
            table.cell(psychTbl, 0, 0, "心理T", text_color=color.white, text_size=size.small)
            table.cell(psychTbl, 1, 0, "価格", text_color=color.white, text_size=size.small)
            table.cell(psychTbl, 2, 0, "件", text_color=color.white, text_size=size.small)
        row = 1
        // Z0: 195 n=14 merged=[194, 195, 196]
        if shown < maxZones and 14 >= minCount and (not onlyDanger or 4 * 1.0 / 14 > 0.5)
            shown += 1
            if showZones
                line.new(chart.left_visible_bar_time, 195.0, chart.right_visible_bar_time, 195.0, xloc=xloc.bar_time, color=color.new(color.gray, 45), width=1, style=line.style_dashed)
            if showLabels
                label.new(chart.right_visible_bar_time, 195.0, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_left, color=color.new(color.purple, 0), textcolor=color.white, size=size.tiny, text="T14 195")
            if showTable and row <= 7
                table.cell(psychTbl, 0, row, "根拠不足", text_color=color.silver, text_size=size.tiny)
                table.cell(psychTbl, 1, row, "195", text_color=color.white, text_size=size.tiny)
                table.cell(psychTbl, 2, row, "14", text_color=color.white, text_size=size.tiny)
                row += 1
        // Z1: 192 n=12 merged=[191, 192, 193]
        if shown < maxZones and 12 >= minCount and (not onlyDanger or 5 * 1.0 / 12 > 0.5)
            shown += 1
            if showZones
                line.new(chart.left_visible_bar_time, 192.0, chart.right_visible_bar_time, 192.0, xloc=xloc.bar_time, color=color.new(color.gray, 45), width=1, style=line.style_dashed)
            if showLabels
                label.new(chart.right_visible_bar_time, 192.0, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_left, color=color.new(color.purple, 0), textcolor=color.white, size=size.tiny, text="T12 192")
            if showTable and row <= 7
                table.cell(psychTbl, 0, row, "根拠不足", text_color=color.silver, text_size=size.tiny)
                table.cell(psychTbl, 1, row, "192", text_color=color.white, text_size=size.tiny)
                table.cell(psychTbl, 2, row, "12", text_color=color.white, text_size=size.tiny)
                row += 1
        // Z2: 189 n=7 merged=[188, 189, 190]
        if shown < maxZones and 7 >= minCount and (not onlyDanger or 2 * 1.0 / 7 > 0.5)
            shown += 1
            if showZones
                line.new(chart.left_visible_bar_time, 189.0, chart.right_visible_bar_time, 189.0, xloc=xloc.bar_time, color=color.new(color.gray, 45), width=1, style=line.style_dashed)
            if showLabels
                label.new(chart.right_visible_bar_time, 189.0, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_left, color=color.new(color.purple, 0), textcolor=color.white, size=size.tiny, text="T7 189")
            if showTable and row <= 7
                table.cell(psychTbl, 0, row, "根拠不足", text_color=color.silver, text_size=size.tiny)
                table.cell(psychTbl, 1, row, "189", text_color=color.white, text_size=size.tiny)
                table.cell(psychTbl, 2, row, "7", text_color=color.white, text_size=size.tiny)
                row += 1
        // Z3: 198 n=5 merged=[197, 198]
        if shown < maxZones and 5 >= minCount and (not onlyDanger or 0 * 1.0 / 5 > 0.5)
            shown += 1
            if showZones
                line.new(chart.left_visible_bar_time, 198.0, chart.right_visible_bar_time, 198.0, xloc=xloc.bar_time, color=color.new(color.gray, 45), width=1, style=line.style_dashed)
            if showLabels
                label.new(chart.right_visible_bar_time, 198.0, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_left, color=color.new(color.purple, 0), textcolor=color.white, size=size.tiny, text="T5 198")
            if showTable and row <= 7
                table.cell(psychTbl, 0, row, "根拠不足", text_color=color.silver, text_size=size.tiny)
                table.cell(psychTbl, 1, row, "198", text_color=color.white, text_size=size.tiny)
                table.cell(psychTbl, 2, row, "5", text_color=color.white, text_size=size.tiny)
                row += 1
        // Z4: 200 n=4 merged=[200]
        if shown < maxZones and 4 >= minCount and (not onlyDanger or 2 * 1.0 / 4 > 0.5)
            shown += 1
            if showZones
                line.new(chart.left_visible_bar_time, 200.0, chart.right_visible_bar_time, 200.0, xloc=xloc.bar_time, color=color.new(color.purple, 25), width=1, style=line.style_dashed)
            if showLabels
                label.new(chart.right_visible_bar_time, 200.0, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_left, color=color.new(color.purple, 0), textcolor=color.white, size=size.tiny, text="T4 200")
            if showTable and row <= 7
                table.cell(psychTbl, 0, row, "根拠不足", text_color=color.silver, text_size=size.tiny)
                table.cell(psychTbl, 1, row, "200", text_color=color.white, text_size=size.tiny)
                table.cell(psychTbl, 2, row, "4", text_color=color.white, text_size=size.tiny)
                row += 1
        // Z5: 184 n=3 merged=[183, 185]
        if shown < maxZones and 3 >= minCount and (not onlyDanger or 1 * 1.0 / 3 > 0.5)
            shown += 1
            if showZones
                line.new(chart.left_visible_bar_time, 184.0, chart.right_visible_bar_time, 184.0, xloc=xloc.bar_time, color=color.new(color.gray, 45), width=1, style=line.style_dashed)
            if showLabels
                label.new(chart.right_visible_bar_time, 184.0, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_left, color=color.new(color.purple, 0), textcolor=color.white, size=size.tiny, text="T3 184")
            if showTable and row <= 7
                table.cell(psychTbl, 0, row, "エントリーが早い", text_color=color.silver, text_size=size.tiny)
                table.cell(psychTbl, 1, row, "184", text_color=color.white, text_size=size.tiny)
                table.cell(psychTbl, 2, row, "3", text_color=color.white, text_size=size.tiny)
                row += 1
