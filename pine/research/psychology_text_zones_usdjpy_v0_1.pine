//@version=5
indicator("Psychology Text Zones - USDJPY v0.1.1 [Research]", overlay=true, max_labels_count=500, max_boxes_count=100, max_lines_count=50)

// =====================================================================
// Psychology Text Zones - USDJPY v0.1.1 [Research]
// ---------------------------------------------------------------------
// 850件心理テキスト（v0.5実行380件と非重複）の意識価格帯
// ソース行 15 → 表示ゾーン 11（近接マージ後・上位のみ）
// 紫破線=意識節目（約定ではない） / 1H推奨 / v0.5と併用時は件数フィルタを上げる
// =====================================================================

pairOk = syminfo.basecurrency == "USD" and syminfo.currency == "JPY"
showZones   = input.bool(true,  "意識価格線(紫破線)を表示")
showLabels  = input.bool(false, "右端ラベルを表示")
showTable   = input.bool(true,  "一覧テーブル(右上)を表示")
maxZones    = input.int(6, "最大表示ゾーン数", minval=1, maxval=20)
minCount    = input.int(3,      "最小件数", minval=1, maxval=20)
onlyDanger  = input.bool(false, "負け率50%超のみ")

var table psychTbl = table.new(position.top_right, 3, 8, bgcolor=color.new(color.black, 15), border_width=1)

// Z0: 140 n=2 loss=1 根拠不足
// Z1: 143 n=2 loss=0 根拠不足
// Z2: 146 n=2 loss=0 エントリーが早い
// Z3: 156 n=2 loss=1 根拠不足
// Z4: 141 n=1 loss=1 根拠不足
// Z5: 148 n=1 loss=0 根拠不足
// Z6: 150 n=1 loss=0 利確・保有判断のブレ
// Z7: 153 n=1 loss=0 根拠不足
// Z8: 158 n=1 loss=1 根拠不足
// Z9: 160 n=1 loss=0 根拠不足
// Z10: 165 n=1 loss=0 根拠不足

if barstate.islast
    if not pairOk
        label.new(bar_index, high, "⚠ USDJPY 専用\n心理テキスト v0.1.1", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_lower_left, color=color.new(color.orange, 0), textcolor=color.white, size=size.normal)
    else
        shown = 0
        if showTable
            table.cell(psychTbl, 0, 0, "心理T", text_color=color.white, text_size=size.small)
            table.cell(psychTbl, 1, 0, "価格", text_color=color.white, text_size=size.small)
            table.cell(psychTbl, 2, 0, "件", text_color=color.white, text_size=size.small)
        row = 1
        // Z0: 140 n=2 merged=[139, 140]
        if shown < maxZones and 2 >= minCount and (not onlyDanger or 1 * 1.0 / 2 > 0.5)
            shown += 1
            if showZones
                line.new(chart.left_visible_bar_time, 140.0, chart.right_visible_bar_time, 140.0, xloc=xloc.bar_time, color=color.new(color.purple, 25), width=1, style=line.style_dashed)
            if showLabels
                label.new(chart.right_visible_bar_time, 140.0, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_left, color=color.new(color.purple, 0), textcolor=color.white, size=size.tiny, text="T2 140")
            if showTable and row <= 7
                table.cell(psychTbl, 0, row, "根拠不足", text_color=color.silver, text_size=size.tiny)
                table.cell(psychTbl, 1, row, "140", text_color=color.white, text_size=size.tiny)
                table.cell(psychTbl, 2, row, "2", text_color=color.white, text_size=size.tiny)
                row += 1
        // Z1: 143 n=2 merged=[143]
        if shown < maxZones and 2 >= minCount and (not onlyDanger or 0 * 1.0 / 2 > 0.5)
            shown += 1
            if showZones
                line.new(chart.left_visible_bar_time, 143.0, chart.right_visible_bar_time, 143.0, xloc=xloc.bar_time, color=color.new(color.gray, 45), width=1, style=line.style_dashed)
            if showLabels
                label.new(chart.right_visible_bar_time, 143.0, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_left, color=color.new(color.purple, 0), textcolor=color.white, size=size.tiny, text="T2 143")
            if showTable and row <= 7
                table.cell(psychTbl, 0, row, "根拠不足", text_color=color.silver, text_size=size.tiny)
                table.cell(psychTbl, 1, row, "143", text_color=color.white, text_size=size.tiny)
                table.cell(psychTbl, 2, row, "2", text_color=color.white, text_size=size.tiny)
                row += 1
        // Z2: 146 n=2 merged=[146, 147]
        if shown < maxZones and 2 >= minCount and (not onlyDanger or 0 * 1.0 / 2 > 0.5)
            shown += 1
            if showZones
                line.new(chart.left_visible_bar_time, 146.0, chart.right_visible_bar_time, 146.0, xloc=xloc.bar_time, color=color.new(color.gray, 45), width=1, style=line.style_dashed)
            if showLabels
                label.new(chart.right_visible_bar_time, 146.0, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_left, color=color.new(color.purple, 0), textcolor=color.white, size=size.tiny, text="T2 146")
            if showTable and row <= 7
                table.cell(psychTbl, 0, row, "エントリーが早い", text_color=color.silver, text_size=size.tiny)
                table.cell(psychTbl, 1, row, "146", text_color=color.white, text_size=size.tiny)
                table.cell(psychTbl, 2, row, "2", text_color=color.white, text_size=size.tiny)
                row += 1
        // Z3: 156 n=2 merged=[155, 156]
        if shown < maxZones and 2 >= minCount and (not onlyDanger or 1 * 1.0 / 2 > 0.5)
            shown += 1
            if showZones
                line.new(chart.left_visible_bar_time, 156.0, chart.right_visible_bar_time, 156.0, xloc=xloc.bar_time, color=color.new(color.purple, 25), width=1, style=line.style_dashed)
            if showLabels
                label.new(chart.right_visible_bar_time, 156.0, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_left, color=color.new(color.purple, 0), textcolor=color.white, size=size.tiny, text="T2 156")
            if showTable and row <= 7
                table.cell(psychTbl, 0, row, "根拠不足", text_color=color.silver, text_size=size.tiny)
                table.cell(psychTbl, 1, row, "156", text_color=color.white, text_size=size.tiny)
                table.cell(psychTbl, 2, row, "2", text_color=color.white, text_size=size.tiny)
                row += 1
        // Z4: 141 n=1 merged=[141]
        if shown < maxZones and 1 >= minCount and (not onlyDanger or 1 * 1.0 / 1 > 0.5)
            shown += 1
            if showZones
                line.new(chart.left_visible_bar_time, 141.0, chart.right_visible_bar_time, 141.0, xloc=xloc.bar_time, color=color.new(color.purple, 25), width=1, style=line.style_dashed)
            if showLabels
                label.new(chart.right_visible_bar_time, 141.0, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_left, color=color.new(color.purple, 0), textcolor=color.white, size=size.tiny, text="T1 141")
            if showTable and row <= 7
                table.cell(psychTbl, 0, row, "根拠不足", text_color=color.silver, text_size=size.tiny)
                table.cell(psychTbl, 1, row, "141", text_color=color.white, text_size=size.tiny)
                table.cell(psychTbl, 2, row, "1", text_color=color.white, text_size=size.tiny)
                row += 1
        // Z5: 148 n=1 merged=[148]
        if shown < maxZones and 1 >= minCount and (not onlyDanger or 0 * 1.0 / 1 > 0.5)
            shown += 1
            if showZones
                line.new(chart.left_visible_bar_time, 148.0, chart.right_visible_bar_time, 148.0, xloc=xloc.bar_time, color=color.new(color.gray, 45), width=1, style=line.style_dashed)
            if showLabels
                label.new(chart.right_visible_bar_time, 148.0, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_left, color=color.new(color.purple, 0), textcolor=color.white, size=size.tiny, text="T1 148")
            if showTable and row <= 7
                table.cell(psychTbl, 0, row, "根拠不足", text_color=color.silver, text_size=size.tiny)
                table.cell(psychTbl, 1, row, "148", text_color=color.white, text_size=size.tiny)
                table.cell(psychTbl, 2, row, "1", text_color=color.white, text_size=size.tiny)
                row += 1
        // Z6: 150 n=1 merged=[150]
        if shown < maxZones and 1 >= minCount and (not onlyDanger or 0 * 1.0 / 1 > 0.5)
            shown += 1
            if showZones
                line.new(chart.left_visible_bar_time, 150.0, chart.right_visible_bar_time, 150.0, xloc=xloc.bar_time, color=color.new(color.gray, 45), width=1, style=line.style_dashed)
            if showLabels
                label.new(chart.right_visible_bar_time, 150.0, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_left, color=color.new(color.purple, 0), textcolor=color.white, size=size.tiny, text="T1 150")
            if showTable and row <= 7
                table.cell(psychTbl, 0, row, "利確・保有判断のブレ", text_color=color.silver, text_size=size.tiny)
                table.cell(psychTbl, 1, row, "150", text_color=color.white, text_size=size.tiny)
                table.cell(psychTbl, 2, row, "1", text_color=color.white, text_size=size.tiny)
                row += 1
        // Z7: 153 n=1 merged=[153]
        if shown < maxZones and 1 >= minCount and (not onlyDanger or 0 * 1.0 / 1 > 0.5)
            shown += 1
            if showZones
                line.new(chart.left_visible_bar_time, 153.0, chart.right_visible_bar_time, 153.0, xloc=xloc.bar_time, color=color.new(color.gray, 45), width=1, style=line.style_dashed)
            if showLabels
                label.new(chart.right_visible_bar_time, 153.0, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_left, color=color.new(color.purple, 0), textcolor=color.white, size=size.tiny, text="T1 153")
            if showTable and row <= 7
                table.cell(psychTbl, 0, row, "根拠不足", text_color=color.silver, text_size=size.tiny)
                table.cell(psychTbl, 1, row, "153", text_color=color.white, text_size=size.tiny)
                table.cell(psychTbl, 2, row, "1", text_color=color.white, text_size=size.tiny)
                row += 1
        // Z8: 158 n=1 merged=[158]
        if shown < maxZones and 1 >= minCount and (not onlyDanger or 1 * 1.0 / 1 > 0.5)
            shown += 1
            if showZones
                line.new(chart.left_visible_bar_time, 158.0, chart.right_visible_bar_time, 158.0, xloc=xloc.bar_time, color=color.new(color.purple, 25), width=1, style=line.style_dashed)
            if showLabels
                label.new(chart.right_visible_bar_time, 158.0, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_left, color=color.new(color.purple, 0), textcolor=color.white, size=size.tiny, text="T1 158")
            if showTable and row <= 7
                table.cell(psychTbl, 0, row, "根拠不足", text_color=color.silver, text_size=size.tiny)
                table.cell(psychTbl, 1, row, "158", text_color=color.white, text_size=size.tiny)
                table.cell(psychTbl, 2, row, "1", text_color=color.white, text_size=size.tiny)
                row += 1
        // Z9: 160 n=1 merged=[160]
        if shown < maxZones and 1 >= minCount and (not onlyDanger or 0 * 1.0 / 1 > 0.5)
            shown += 1
            if showZones
                line.new(chart.left_visible_bar_time, 160.0, chart.right_visible_bar_time, 160.0, xloc=xloc.bar_time, color=color.new(color.gray, 45), width=1, style=line.style_dashed)
            if showLabels
                label.new(chart.right_visible_bar_time, 160.0, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_left, color=color.new(color.purple, 0), textcolor=color.white, size=size.tiny, text="T1 160")
            if showTable and row <= 7
                table.cell(psychTbl, 0, row, "根拠不足", text_color=color.silver, text_size=size.tiny)
                table.cell(psychTbl, 1, row, "160", text_color=color.white, text_size=size.tiny)
                table.cell(psychTbl, 2, row, "1", text_color=color.white, text_size=size.tiny)
