//@version=5
indicator("Student Real Entries Overlay - GBPJPY [Research]", overlay=true, max_labels_count=500, max_lines_count=500)

// =====================================================================
// Student Real Entries Overlay - GBPJPY v0.1 [Research]
// ---------------------------------------------------------------------
// 目的: 受講生の「実際の入った場所」を、実日時×実価格でチャートに重ねる。
//   文章クラスタではなく、本当に同じ価格・同じ時間に複数人が入ったかを
//   目視できるようにする。
//
// データ: outputs/student_entries_extracted.csv (画像から抽出, JST)
//   この版は GBPJPY 1H のエントリーのみ収録(7件)。
//   ※GBPJPY 1H チャートを表示して使ってください。
//
// 着色: 勝ち=緑 / 負け=赤   形: 買い=下から上ラベル / 売り=上から下ラベル
// 注意: 学生の手入力には誤記あり。価格がチャートと大きくズレる点は
//       データ品質フラグ(CSVのnote/confidence)を参照。
// =====================================================================

showWin  = input.bool(true,  "勝ちエントリーを表示(緑)")
showLoss = input.bool(true,  "負けエントリーを表示(赤)")
showLine = input.bool(true,  "エントリー価格に水平ライン")

// エントリー定義(JST = GMT+9)
// 並び: 2024/9/2, 9/14, 9/18(x3), 10/14, 12/11
entryTs   = array.from(timestamp("GMT+9", 2024, 9,  2, 17, 33), timestamp("GMT+9", 2024, 9, 14, 3,  0), timestamp("GMT+9", 2024, 9, 18, 4, 39), timestamp("GMT+9", 2024, 9, 18, 16, 7), timestamp("GMT+9", 2024, 9, 18, 18, 30), timestamp("GMT+9", 2024, 10, 14, 20, 0), timestamp("GMT+9", 2024, 12, 11, 8, 14))
entryPx   = array.from(192.91, 184.914, 187.223, 186.790, 180.297, 195.351, 194.024)
entrySide = array.from(1, -1, 1, 1, 1, 1, 1)            // 1=買い -1=売り
entryRes  = array.from(0, 0, 0, 1, 1, 0, 0)             // 1=勝ち 0=負け
entryId   = array.from("022A1F07", "28D3622F", "43570A72", "4C7E6392", "0A8AE576", "75718625", "008B0F5D")

if barstate.islast
    for i = 0 to array.size(entryTs) - 1
        res  = array.get(entryRes, i)
        side = array.get(entrySide, i)
        px   = array.get(entryPx, i)
        ts   = array.get(entryTs, i)
        id   = array.get(entryId, i)
        show = (res == 1 and showWin) or (res == 0 and showLoss)
        if show
            col   = res == 1 ? color.new(color.lime, 0) : color.new(color.red, 0)
            sideS = side == 1 ? "買" : "売"
            sty   = side == 1 ? label.style_label_up : label.style_label_down
            label.new(x=ts, y=px, xloc=xloc.bar_time, style=sty, color=col, textcolor=color.white, size=size.small, text=id + " " + sideS)
            if showLine
                line.new(x1=ts, y1=px, x2=ts + 1000 * 60 * 60 * 24, y2=px, xloc=xloc.bar_time, color=color.new(col, 60), width=1)
