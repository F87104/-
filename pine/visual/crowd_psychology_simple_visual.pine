//@version=5
indicator("Crowd Psychology Simple v0.3", overlay=true, max_labels_count=200, max_lines_count=100, max_bars_back=2000)

// =====================================================================
// 群衆心理シンプル版 v0.3
// =====================================================================
// 目的:
//   リアルタイムで迷わないように、表示を3つだけにする。
//
//   S = STOP  今すぐ入らない
//   W = WAIT  待つだけ
//   C = CHECK 候補として確認
//
// 注意:
//   売買サインではなく、反応を遅らせるための研究用表示です。
// =====================================================================

grpCore = "基本"
atrLen = input.int(14, "ATR期間", minval=1, group=grpCore)
emaLen = input.int(50, "方向EMA", minval=2, group=grpCore)
levelLookback = input.int(144, "節目 lookback", minval=20, group=grpCore)
breakBufferAtr = input.float(0.08, "節目抜け余白(ATR)", minval=0.0, step=0.01, group=grpCore)
minBreakBody = input.float(0.50, "抜け足の最小実体比率", minval=0.0, maxval=1.0, step=0.05, group=grpCore)

grpStop = "STOP"
stopFreshBreak = input.bool(true, "節目抜け直後をSTOP", group=grpStop)
extensionLookback = input.int(20, "伸び切り判定バー数", minval=5, group=grpStop)
extensionAtr = input.float(2.0, "伸び切りATR", minval=0.5, step=0.1, group=grpStop)
runLen = input.int(4, "連続足しきい値", minval=1, group=grpStop)
rangeLookback = input.int(96, "レンジ lookback", minval=20, group=grpStop)
rangeMaxAtr = input.float(8.0, "レンジ最大幅(ATR)", minval=1.0, step=0.5, group=grpStop)
rangeMidLo = input.float(0.30, "レンジ中央 下限", minval=0.0, maxval=1.0, step=0.05, group=grpStop)
rangeMidHi = input.float(0.70, "レンジ中央 上限", minval=0.0, maxval=1.0, step=0.05, group=grpStop)
impulseBodyAtr = input.float(0.90, "急変実体ATR", minval=0.1, step=0.1, group=grpStop)

grpWait = "WAIT/CHECK"
minBarsAfterBreak = input.int(4, "最低待機バー数", minval=1, maxval=30, group=grpWait)
maxWaitBars = input.int(36, "確認待ち最大バー数", minval=3, group=grpWait)
retestTolAtr = input.float(0.30, "押し戻り許容幅(ATR)", minval=0.05, step=0.05, group=grpWait)
checkConfirmAtr = input.float(0.18, "CHECK再加速余白(ATR)", minval=0.0, step=0.01, group=grpWait)
outsideBarsNeed = input.int(4, "レンジ外定着バー数", minval=1, maxval=20, group=grpWait)
checkNeedsEma = input.bool(true, "CHECKにEMA方向一致を使う", group=grpWait)

grpView = "表示"
showSignals = input.bool(true, "STOP/WAIT/CHECKを表示", group=grpView)
showLevels = input.bool(true, "節目とレンジを表示", group=grpView)
showEma = input.bool(true, "EMAを表示", group=grpView)
showLegend = input.bool(true, "S/W/C説明を表示", group=grpView)
paintZones = input.bool(false, "背景を薄く塗る", group=grpView)
useBarClose = input.bool(true, "確定足だけ表示", group=grpView)
cooldownBars = input.int(48, "同じ表示の間隔", minval=0, maxval=200, group=grpView)

atr = ta.atr(atrLen)
ema = ta.ema(close, emaLen)
barOk = not useBarClose or barstate.isconfirmed

barRange = high - low
body = math.abs(close - open)
bodyRatio = barRange > 0 ? body / barRange : 0.0

keyHigh = ta.highest(high[1], levelLookback)
keyLow = ta.lowest(low[1], levelLookback)
breakBuf = atr * breakBufferAtr

canFire(int lastIndex) =>
    na(lastIndex) or bar_index - lastIndex >= cooldownBars

var int upRun = 0
upRun := close > close[1] ? upRun + 1 : 0

var int downRun = 0
downRun := close < close[1] ? downRun + 1 : 0

// STOP: 節目抜け直後の飛び乗り、またはレンジ中央の急変
breakoutLongCross = ta.crossover(close, keyHigh + breakBuf)
breakoutShortCross = ta.crossunder(close, keyLow - breakBuf)
strongBreakLong = close > open and bodyRatio >= minBreakBody
strongBreakShort = close < open and bodyRatio >= minBreakBody

extendedUp = close - ta.lowest(low, extensionLookback) >= atr * extensionAtr
extendedDown = ta.highest(high, extensionLookback) - close >= atr * extensionAtr

freshBreakLongRaw = barOk and stopFreshBreak and breakoutLongCross and strongBreakLong
freshBreakShortRaw = barOk and stopFreshBreak and breakoutShortCross and strongBreakShort
fomoLongRaw = barOk and breakoutLongCross and strongBreakLong and (extendedUp or upRun >= runLen)
fomoShortRaw = barOk and breakoutShortCross and strongBreakShort and (extendedDown or downRun >= runLen)

rangeHigh = ta.highest(high[1], rangeLookback)
rangeLow = ta.lowest(low[1], rangeLookback)
rangeWidth = rangeHigh - rangeLow
rangeLike = atr > 0 and rangeWidth <= atr * rangeMaxAtr
rangePos = rangeWidth > 0 ? (close - rangeLow) / rangeWidth : na
rangeMid = rangeLike and rangePos >= rangeMidLo and rangePos <= rangeMidHi

panicBuyRaw = barOk and rangeMid and close > open and body >= atr * impulseBodyAtr
panicSellRaw = barOk and rangeMid and close < open and body >= atr * impulseBodyAtr

stopLongRaw = freshBreakLongRaw or fomoLongRaw or panicBuyRaw
stopShortRaw = freshBreakShortRaw or fomoShortRaw or panicSellRaw

// WAIT/CHECK: 抜けたあとに一度待ってから確認する
var bool breakLongActive = false
var bool breakLongRetested = false
var int breakLongIndex = na
var float breakLongLevel = na

var bool breakShortActive = false
var bool breakShortRetested = false
var int breakShortIndex = na
var float breakShortLevel = na

if barOk and breakoutLongCross
    breakLongActive := true
    breakLongRetested := false
    breakLongIndex := bar_index
    breakLongLevel := keyHigh

if barOk and breakoutShortCross
    breakShortActive := true
    breakShortRetested := false
    breakShortIndex := bar_index
    breakShortLevel := keyLow

if breakLongActive and bar_index - breakLongIndex > maxWaitBars
    breakLongActive := false
    breakLongRetested := false

if breakShortActive and bar_index - breakShortIndex > maxWaitBars
    breakShortActive := false
    breakShortRetested := false

longWaitEnough = breakLongActive and not na(breakLongIndex) and bar_index - breakLongIndex >= minBarsAfterBreak
shortWaitEnough = breakShortActive and not na(breakShortIndex) and bar_index - breakShortIndex >= minBarsAfterBreak
waitLongRaw = barOk and longWaitEnough and not breakLongRetested and low <= breakLongLevel + atr * retestTolAtr and close >= breakLongLevel
waitShortRaw = barOk and shortWaitEnough and not breakShortRetested and high >= breakShortLevel - atr * retestTolAtr and close <= breakShortLevel

if waitLongRaw
    breakLongRetested := true

if waitShortRaw
    breakShortRetested := true

emaLongOk = not checkNeedsEma or close > ema
emaShortOk = not checkNeedsEma or close < ema
checkBreakLongRaw = barOk and breakLongActive and breakLongRetested and not waitLongRaw and close > high[1] and close > breakLongLevel + atr * checkConfirmAtr and emaLongOk
checkBreakShortRaw = barOk and breakShortActive and breakShortRetested and not waitShortRaw and close < low[1] and close < breakShortLevel - atr * checkConfirmAtr and emaShortOk

if checkBreakLongRaw
    breakLongActive := false
    breakLongRetested := false

if checkBreakShortRaw
    breakShortActive := false
    breakShortRetested := false

var int outsideLongCount = 0
outsideLongCount := rangeLike and close > rangeHigh + breakBuf ? outsideLongCount + 1 : 0

var int outsideShortCount = 0
outsideShortCount := rangeLike and close < rangeLow - breakBuf ? outsideShortCount + 1 : 0

checkOutsideLongRaw = barOk and outsideLongCount >= outsideBarsNeed and nz(outsideLongCount[1]) < outsideBarsNeed and emaLongOk
checkOutsideShortRaw = barOk and outsideShortCount >= outsideBarsNeed and nz(outsideShortCount[1]) < outsideBarsNeed and emaShortOk

checkLongRaw = checkBreakLongRaw or checkOutsideLongRaw
checkShortRaw = checkBreakShortRaw or checkOutsideShortRaw

// 表示の間引き
var int lastStop = na
var int lastWait = na
var int lastCheck = na

stopOk = canFire(lastStop)
waitOk = canFire(lastWait)
checkOk = canFire(lastCheck)

stopLong = stopLongRaw and stopOk
stopShort = stopShortRaw and stopOk
waitLong = waitLongRaw and waitOk
waitShort = waitShortRaw and waitOk
checkLong = checkLongRaw and checkOk
checkShort = checkShortRaw and checkOk

if stopLong or stopShort
    lastStop := bar_index

if waitLong or waitShort
    lastWait := bar_index

if checkLong or checkShort
    lastCheck := bar_index

stopAny = stopLong or stopShort
waitAny = waitLong or waitShort
checkAny = checkLong or checkShort

plot(showEma ? ema : na, "方向EMA", color=color.new(color.blue, 65), linewidth=1)
plot(showLevels ? keyHigh : na, "節目上限", color=color.new(color.orange, 65), style=plot.style_linebr)
plot(showLevels ? keyLow : na, "節目下限", color=color.new(color.aqua, 65), style=plot.style_linebr)
plot(showLevels and rangeLike ? rangeHigh : na, "レンジ上限", color=color.new(color.yellow, 65), style=plot.style_linebr)
plot(showLevels and rangeLike ? rangeLow : na, "レンジ下限", color=color.new(color.yellow, 65), style=plot.style_linebr)

plotshape(showSignals and stopLong, title="STOP 上方向", style=shape.xcross, location=location.abovebar, color=color.new(color.red, 0), textcolor=color.red, size=size.tiny, text="S")
plotshape(showSignals and stopShort, title="STOP 下方向", style=shape.xcross, location=location.belowbar, color=color.new(color.red, 0), textcolor=color.red, size=size.tiny, text="S")
plotshape(showSignals and waitLong, title="WAIT 上方向", style=shape.circle, location=location.belowbar, color=color.new(color.yellow, 0), textcolor=color.yellow, size=size.tiny, text="W")
plotshape(showSignals and waitShort, title="WAIT 下方向", style=shape.circle, location=location.abovebar, color=color.new(color.yellow, 0), textcolor=color.yellow, size=size.tiny, text="W")
plotshape(showSignals and checkLong, title="CHECK 上方向", style=shape.triangleup, location=location.belowbar, color=color.new(color.lime, 0), textcolor=color.lime, size=size.tiny, text="C")
plotshape(showSignals and checkShort, title="CHECK 下方向", style=shape.triangledown, location=location.abovebar, color=color.new(color.lime, 0), textcolor=color.lime, size=size.tiny, text="C")

bgcolor(paintZones and stopAny ? color.new(color.red, 92) : na, title="STOP背景")
bgcolor(paintZones and waitAny ? color.new(color.yellow, 92) : na, title="WAIT背景")
bgcolor(paintZones and checkAny ? color.new(color.green, 92) : na, title="CHECK背景")

var table swcLegend = table.new(position.top_right, 2, 4, border_width=1)
if barstate.islast
    if showLegend
        table.cell(swcLegend, 0, 0, "表示", text_color=color.white, bgcolor=color.new(color.black, 0), text_size=size.small)
        table.cell(swcLegend, 1, 0, "意味", text_color=color.white, bgcolor=color.new(color.black, 0), text_size=size.small)
        table.cell(swcLegend, 0, 1, "S", text_color=color.white, bgcolor=color.new(color.red, 0), text_size=size.small)
        table.cell(swcLegend, 1, 1, "STOP 入らない", text_color=color.white, bgcolor=color.new(color.red, 75), text_size=size.small)
        table.cell(swcLegend, 0, 2, "W", text_color=color.black, bgcolor=color.new(color.yellow, 0), text_size=size.small)
        table.cell(swcLegend, 1, 2, "WAIT 待つ", text_color=color.white, bgcolor=color.new(color.yellow, 80), text_size=size.small)
        table.cell(swcLegend, 0, 3, "C", text_color=color.black, bgcolor=color.new(color.lime, 0), text_size=size.small)
        table.cell(swcLegend, 1, 3, "CHECK 確認", text_color=color.white, bgcolor=color.new(color.green, 75), text_size=size.small)
    else
        table.cell(swcLegend, 0, 0, "", bgcolor=color.new(color.black, 100))
        table.cell(swcLegend, 1, 0, "", bgcolor=color.new(color.black, 100))
        table.cell(swcLegend, 0, 1, "", bgcolor=color.new(color.black, 100))
        table.cell(swcLegend, 1, 1, "", bgcolor=color.new(color.black, 100))
        table.cell(swcLegend, 0, 2, "", bgcolor=color.new(color.black, 100))
        table.cell(swcLegend, 1, 2, "", bgcolor=color.new(color.black, 100))
        table.cell(swcLegend, 0, 3, "", bgcolor=color.new(color.black, 100))
        table.cell(swcLegend, 1, 3, "", bgcolor=color.new(color.black, 100))

alertcondition(stopAny, "STOP: すぐ入らない", "Crowd Psychology Simple STOP: {{ticker}} {{interval}}")
alertcondition(waitAny, "WAIT: 待つだけ", "Crowd Psychology Simple WAIT: {{ticker}} {{interval}}")
alertcondition(checkAny, "CHECK: 候補確認", "Crowd Psychology Simple CHECK: {{ticker}} {{interval}}")
